# Copy this file to .env and fill in real values for local development.
# .env is gitignored; .env.example is committed as documentation of required config.

# ---------------------------------------------------------------------------
# Timezone — the venue is in Kalibo, Philippines (UTC+8, no DST). "Date-only"
# values throughout this app (OpenPlayNightSession.date, registrations,
# QueueEntry.date, etc.) are built via `new Date(y, m, d)`, which uses the
# Node process's OS-local timezone. That construction must always mean
# PH-local midnight — Postgres stores the UTC-shifted result into naive
# `timestamp` columns, and any SQL-side date-of-week logic (see migration
# 12_fix_registration_weekday_check_timezone) assumes a fixed +8h offset to
# recover it. If this process ever runs with a different TZ, both app-level
# date construction and that migration's CHECK constraint go wrong together.
# ---------------------------------------------------------------------------
TZ="Asia/Manila"

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml's postgres service by default)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://courtroom:courtroom_dev_password@localhost:5432/tcpms_dev"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate a secret with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-output-of-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Feature flags (env-based; see lib/feature-flags.ts)
# Staff sign in with an admin-issued username/password (Employee Management)
# — there is no OAuth/self-registration path. These flags are reserved for
# future modules so they can be toggled without new plumbing.
# ---------------------------------------------------------------------------
FEATURE_PAYMENTS="false"
FEATURE_OPEN_PLAY="false"
FEATURE_TOURNAMENTS="false"
FEATURE_MEMBERSHIPS="false"
FEATURE_EQUIPMENT_RENTALS="false"

# ---------------------------------------------------------------------------
# Service abstractions (Phase 1 uses the "local"/"console" implementation of
# each)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="local"
EMAIL_PROVIDER="console"
UPLOAD_PROVIDER="local"
SMS_PROVIDER="console"

# ---------------------------------------------------------------------------
# DigitalOcean Spaces — only required when UPLOAD_PROVIDER="spaces"
# (production). Leave unset for local dev (UPLOAD_PROVIDER="local").
# ---------------------------------------------------------------------------
# SPACES_KEY="replace-with-spaces-access-key"
# SPACES_SECRET="replace-with-spaces-secret-key"
# SPACES_BUCKET="thecourtroom"
# SPACES_REGION="sgp1"
# SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"

# ---------------------------------------------------------------------------
# Logging (lib/logger.ts) — one of: fatal, error, warn, info, debug, trace
# ---------------------------------------------------------------------------
LOG_LEVEL="debug"
