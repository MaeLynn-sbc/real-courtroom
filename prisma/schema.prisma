// TCPMS schema.
// Phase 1 added authentication + database-backed RBAC (Role, Permission,
// RolePermission, User, Account, Session, VerificationToken).
// Phase 2 added the full domain data model per ARCHITECTURE.md's DATABASE
// section — schema and seed data only, no services/actions/UI/APIs for any
// of it yet (see the module comment headers below).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- RBAC -------------------------------------------------------------
// Role and Permission are real tables (not enums) so permissions can be
// reconfigured from the database later without a code change. The fixed
// set of system role keys also exists in code as `types/roles.ts:
// SYSTEM_ROLES`, used only for seeding and type-narrowing — the database
// is always the source of truth for which permissions a role grants.

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  // v1.1: true for the roles seeded out of the box. The Roles workspace
  // lets an Owner edit any role's label/description/permission set, but
  // blocks deleting a role or renaming its stable `name` key when this is
  // true — some code paths (e.g. Player creation) still look a role up by
  // that stable name.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// --- Auth.js (NextAuth v5) ----------------------------------------------
// Standard Prisma-adapter shape (Account, Session, VerificationToken) so the
// optional Google provider can link accounts. Sessions are JWT-based in
// Phase 1, so the Session table exists for adapter type-compatibility and
// future flexibility but is not written to at runtime.

model User {
  id                 String    @id @default(cuid())
  name               String?
  // v1.1: email became optional and is no longer the login identifier —
  // username is (see Employee below). Existing rows keep their email; a
  // loosened constraint, not a narrowing, so this stays additive.
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  username           String?   @unique
  passwordHash       String?
  // v1.2: true for an admin-created account or a fresh admin password
  // reset, both of which set a system-generated temp password never
  // chosen by the admin (see employee.service.ts). Cleared only by the
  // user successfully changing their own password. Enforced server-side
  // in lib/rbac.ts (page/action routing) and lib/action-auth.ts
  // (requirePermission) — never trust a client-side redirect alone for
  // this.
  mustChangePassword Boolean   @default(false)
  // Stamped every time passwordHash is set (creation, admin reset, or
  // self-service change) — the version stamp auth.ts's jwt() callback
  // compares on every request to invalidate a token issued before the
  // most recent password change, since this app's JWT session strategy
  // has no server-side session table to revoke rows from directly.
  passwordChangedAt  DateTime?
  roleId             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  role     Role      @relation(fields: [roleId], references: [id])
  accounts Account[]
  sessions Session[]

  // Phase 2 relations
  player                            Player?
  // v1.1
  employee                          Employee?
  bookingsCreated                   Booking[]                 @relation("BookingBookedBy")
  // Settle-bill: who actually recorded the payment, distinct from who
  // created the booking (bookingsCreated above) — usually the same
  // employee, not always (a booking created at 2pm might be settled by
  // whoever's on the desk when the customer actually pays, hours later).
  bookingsSettled                   Booking[]                 @relation("BookingSettledBy")
  bookingHistoryChanges             BookingHistory[]
  coachSessionsBooked               CoachSession[]
  coachSessionHistoryChanges        CoachSessionHistory[]
  courtMaintenanceCreated           CourtMaintenance[]
  payments                          Payment[]
  invoices                          Invoice[]
  tournamentsCreated                Tournament[]
  announcementsCreated              Announcement[]
  notifications                     Notification[]
  auditLogs                         AuditLog[]
  settingsUpdated                   Setting[]
  eventsCreated                     Event[]
  openPlayMatchesCompleted          OpenPlayMatch[]
  gameAssignmentsCreated            GameAssignment[]
  membershipHistoryChanges          MembershipHistory[]
  equipmentMaintenanceLogsPerformed EquipmentMaintenanceLog[]
  lockerMaintenanceLogsPerformed    LockerMaintenanceLog[]
  // Payroll Batch 1 — who corrected an attendance record's clock times.
  attendanceRecordsCorrected        AttendanceRecord[]
  // Payroll Batch 2b — who entered a given effective-dated rate.
  employeeRatesCreated              EmployeeRate[]
  // Payroll Batch 2c — who marked a date as a rest day/holiday.
  payrollMarkedDatesCreated         PayrollMarkedDate[]

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Players & Ratings ---------------------------------------------------
// Player is the pickleball-specific profile extending a User 1:1 (Player
// Profiles module). PlayerRating and PlayerStatistics are split into their
// own tables, matching ARCHITECTURE.md's DATABASE entity list, so ratings
// and aggregate stats can be recomputed independently of the profile.

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

// BUILD-SPEC.md §4 — a different, distinctly-named concept from SkillLevel
// above: SkillLevel is the Player-Profiles/Tournament seeding rating
// (admin-assigned, includes PRO for competitive seeding). This is a
// self-rated, casual level collected for every open play registration to
// keep rotations fair, with its own 4-value scale (Novice, not Pro) and
// its own required onscreen descriptions (see
// types/open-play-skill-levels.ts). Declared in this exact order — 1-4,
// not alphabetical — since Postgres/Prisma enums sort by declaration
// order, and BUILD-SPEC.md is explicit that alphabetical would be wrong
// (Advanced first, Novice second).
enum OpenPlaySkillLevel {
  BEGINNER
  NOVICE
  INTERMEDIATE
  ADVANCED
}

enum DominantHand {
  LEFT
  RIGHT
  AMBIDEXTROUS
}

enum PlayerPosition {
  LEFT
  RIGHT
  BOTH
}

enum StreakType {
  WIN
  LOSS
}

model Player {
  id                 String              @id @default(cuid())
  userId             String              @unique
  photoUrl           String?
  bio                String?
  phone              String?
  dateOfBirth        DateTime?
  skillLevel         SkillLevel?
  // Open-play self-rating (BUILD-SPEC.md §4), prefilled into the
  // registration form next time and still editable there — separate from
  // the tournament-seeding `skillLevel` above. Staff corrections here are
  // audit-logged (see PlayerService) and never rewrite past
  // OpenPlayNightRegistration rows, which snapshot their own value.
  openPlaySkillLevel OpenPlaySkillLevel?
  dominantHand       DominantHand?
  position           PlayerPosition?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating                     PlayerRating?
  statistics                 PlayerStatistics?
  teamsAsPlayer1             Team[]                      @relation("TeamPlayer1")
  teamsAsPlayer2             Team[]                      @relation("TeamPlayer2")
  memberships                Membership[]
  openPlayRegistrations      OpenPlayRegistration[]
  openPlayNightRegistrations OpenPlayNightRegistration[]
  bookings                   Booking[]
  coachSessions              CoachSession[]
  equipmentRentals           EquipmentRental[]
  lockerRentals              LockerRental[]
  sales                      Sale[]

  @@index([deletedAt])
}

model PlayerRating {
  id            String      @id @default(cuid())
  playerId      String      @unique
  eloRating     Int         @default(1200)
  duprRating    Float?
  currentStreak Int         @default(0)
  streakType    StreakType?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerStatistics {
  id                String   @id @default(cuid())
  playerId          String   @unique
  matchesPlayed     Int      @default(0)
  matchesWon        Int      @default(0)
  matchesLost       Int      @default(0)
  winPercentage     Float    @default(0)
  tournamentsPlayed Int      @default(0)
  tournamentsWon    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Team {
  id        String    @id @default(cuid())
  name      String?
  player1Id String
  player2Id String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  player1 Player  @relation("TeamPlayer1", fields: [player1Id], references: [id])
  player2 Player? @relation("TeamPlayer2", fields: [player2Id], references: [id])

  tournamentRegistrations TournamentRegistration[]
  matchesAsTeam1          Match[]                  @relation("MatchTeam1")
  matchesAsTeam2          Match[]                  @relation("MatchTeam2")
  matchesWon              Match[]                  @relation("MatchWinnerTeam")

  @@index([player1Id])
  @@index([player2Id])
}

// --- Employees & Shifts (v1.1) ----------------------------------------------
// Employee is the staff-specific profile extending a User 1:1 — the exact
// precedent Player already set for members. Employees are staff, Players
// are customers; the two are never the same User row. Login is by
// User.username; Employee holds the day-to-day staff fields (name shown on
// receipts/shift logs, phone, photo, active/inactive).

model Employee {
  id             String    @id @default(cuid())
  userId         String    @unique
  // "EMP-0001" — sequential, generated the same count-then-retry-on-
  // collision way as Booking.bookingReference, just with no date component
  // since an employee number is a stable identity, not a per-day sequence.
  employeeNumber String    @unique
  firstName      String
  lastName       String
  phone          String?
  photoUrl       String?
  // Public coaching page (app/coaches/page.tsx), shown directly under
  // the coach's name — e.g. "Pickleball Development Coach". Same
  // nullable, simply-omitted-when-empty treatment as bio/photoUrl.
  title          String?
  // New coaching page (public, no login): a short bio shown alongside
  // photoUrl for any coach who has one — same "leave room for it, don't
  // block the page" treatment as photoUrl already gets (both nullable,
  // both simply omitted from the public page when empty). Free text, not
  // owner-editable via the CMS's CMS_KEYS pattern (that's for global
  // site-singleton sections — hero, gallery — not per-employee data);
  // edited the same place photoUrl already is, employee-detail-panel.tsx.
  bio            String?
  // v1.2: the ONLY supported way to remove an employee's access —
  // checked in auth.ts's authorize() to block login. There is no delete
  // action anywhere in this codebase for Employee or its User, and none
  // should be added: this row is required-FK attribution on Sale
  // (employeeId), Shift (employeeId), and PlayerTab write-offs
  // (writtenOffTabs) — deleting it would either cascade-destroy
  // financial/audit history or violate those constraints outright.
  // deletedAt below is unused for Employee — inherited from the
  // project's general soft-delete column convention, never wired to an
  // actual delete path.
  isActive       Boolean   @default(true)
  // v1.2 DRAFT (Gate 1): placeholder capability flag — item 4 (coach
  // designation mechanics, e.g. whether this becomes a real permission
  // instead) wasn't received yet. Kept as a simple boolean, matching
  // isActive's own style, only so CoachSession/CoachAvailabilityWindow
  // below have something to gate against for this schema review; not
  // wired into any authorization check yet.
  isCoach        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user                                      User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts                                    Shift[]
  sales                                     Sale[]
  writtenOffTabs                            PlayerTab[]
  writtenOffBookingTabs                     BookingTab[]
  // Owner request (2026-08-08) — see Sale.paymentMethodCorrectedByEmployeeId
  // below, and saleService.correctPaymentMethod's own comment.
  paymentMethodCorrectedSales               Sale[]                             @relation("SalePaymentMethodCorrectedBy")
  // Phase 8 plumbing — see BookingPaymentProof/BookingRefund, below Sale.
  resolvedBookingPaymentProofs              BookingPaymentProof[]
  issuedBookingRefunds                      BookingRefund[]
  confirmedGcashDailyBalances               GcashDailyBalance[]
  confirmedCashDailyBalances                CashDailyBalance[]
  // Open-play cancellation policy Gate 1 — see OpenPlayRefund, below
  // OpenPlayCredit.
  issuedOpenPlayRefunds                     OpenPlayRefund[]
  coachSessions                             CoachSession[]                     @relation("CoachSessionsCoached")
  coachAvailabilityWindows                  CoachAvailabilityWindow[]          @relation("CoachAvailabilityWindows")
  coachRates                                CoachRate[]                        @relation("CoachRates")
  // Open-play online self-registration, Gate 1 plumbing — see
  // OpenPlayRegistrationPaymentProof, below QueueEntry.
  resolvedOpenPlayRegistrationPaymentProofs OpenPlayRegistrationPaymentProof[]
  // Expenses tracking Gate 1 — see Expense, below GcashDailyBalance's spot
  // in the file (or Sale, whichever lands nearest at merge time).
  recordedExpenses                          Expense[]
  // Payroll Batch 1 — see ScheduleAssignment/AttendanceRecord, below
  // Shift's own spot in the file.
  scheduleAssignments                       ScheduleAssignment[]
  attendanceRecords                         AttendanceRecord[]
  // Payroll Batch 2b — see EmployeeRate, below AttendanceRecord's own
  // spot in the file.
  rates                                     EmployeeRate[]

  @@index([deletedAt])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id                   String      @id @default(cuid())
  // "SHIFT-20260722-001" — same date + per-day-sequence pattern as every
  // other human-facing reference code in this app.
  shiftNumber          String      @unique
  employeeId           String
  status               ShiftStatus @default(OPEN)
  // Philippine business terminology: "Opening Cash" / "Closing Cash", not
  // "float" / "cash count".
  openingCashCents     Int         @default(0)
  closingCashCents     Int?
  // Gate 1 (shift cash reconciliation): now actually computed and written
  // on close — variance = closingCash - (openingCash + cashSales). Sale
  // is shift-scoped (Sale.shiftId below) and cash-filterable via
  // PaymentMethod.key = "CASH" (saleService.getCashSalesForShift).
  varianceCents        Int?
  openingNotes         String?
  closingNotes         String?
  // Gate 1: denomination quantities staff actually counted at close
  // (e.g. {"1000": 5, "500": 2, ...}, peso value -> quantity) — a real
  // audit trail of what was counted, not just the resulting total.
  // closingCashCents is computed FROM this server-side (never trusted
  // from the client directly), same "don't trust client arithmetic for
  // money" reasoning as every Sale-creating action in this app. Null for
  // shifts closed before this existed.
  closingCashBreakdown Json?
  startedAt            DateTime    @default(now())
  endedAt              DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  employee          Employee           @relation(fields: [employeeId], references: [id])
  sales             Sale[]
  // Payroll Batch 1: set only once a later batch wires "till open/close
  // seeds an AttendanceRecord" — see AttendanceRecord.shiftId's own
  // comment. Always empty for now.
  attendanceRecords AttendanceRecord[]

  // Only one OPEN shift per employee is enforced at the service layer;
  // this index supports that lookup. Multiple CLOSED shifts per employee
  // per day are fine — nothing prevents clocking in more than once a day.
  @@index([employeeId, status])
  @@index([startedAt])
}

// Payroll Batch 1 (2026-08-02). Supersedes the never-deployed
// ScheduledShift/TimeLogEntry pair (see commit 5b1599c) — same overall
// shape, corrected: employeeId not userId (matching every other staff-
// linked model in this file, Shift included), and this time actually
// wired to a real service, action, and UI before landing.
//
// ShiftTemplate: owner-defined named presets ("Opening"/"Closing").
// startTime/endTime are bare "HH:MM" time-of-day strings, not DateTimes
// — a template describes a repeatable daily window, not a specific
// date, same reasoning CoachAvailabilityWindow's own date-scoped rows
// (below) apply to "materialize per-date, don't build a recurrence-rule
// engine." Combined with a real workDate on ScheduleAssignment to
// produce actual scheduledStart/scheduledEnd instants.
model ShiftTemplate {
  id        String   @id @default(cuid())
  // Payroll Batch 2a: unique so seeding/admin edits can use a real
  // prisma.shiftTemplate.upsert() keyed on name, same as every other
  // owner-managed reference table seeded by stable name
  // (MembershipPlan.name, ExpenseCategory.name) — without this, an
  // idempotent seed needs an awkward findFirst-then-create instead.
  name      String   @unique
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleAssignments ScheduleAssignment[]
}

// One row per employee per work day — @@unique enforces that directly
// (stronger than ScheduledShift's old "delete-then-recreate" service-
// layer-only invariant). templateId is nullable: a day can be assigned
// from a named template or hand-typed custom hours; isOverride flags
// the latter case (or a template day whose times were hand-adjusted)
// for the Timesheet UI's "this day deviates from the default" treatment
// — meaningless without templateId existing, which is exactly why it
// didn't exist on the old, template-less ScheduledShift.
model ScheduleAssignment {
  id             String   @id @default(cuid())
  employeeId     String
  workDate       DateTime
  templateId     String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  isOverride     Boolean  @default(false)
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee       @relation(fields: [employeeId], references: [id])
  template ShiftTemplate? @relation(fields: [templateId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate])
}

enum AttendanceSource {
  MANUAL
  LIVE
}

// Payroll's own presence record — deliberately separate from Shift
// (till-custody audit record: "the till was open X to Y") rather than
// overloading it, so correcting a payroll clock time can never rewrite
// a cash-custody fact. shiftId is the seam for a later batch to wire
// "closing a till seeds/links the day's AttendanceRecord" (source
// becomes LIVE then) — nullable so a MANUAL entry (an absence, or a day
// worked with no till ever opened) has a home with nothing to link to.
// rawClockIn/rawClockOut are captured once, at creation, from whatever
// clockIn/clockOut held at that moment, and never touched again — same
// "the original survives independently of AuditLog" intent TimeLogEntry's
// original* fields had, just always populated instead of only-after-
// first-correction. Every field name here matches TimeLogEntry's own
// established convention (correctedByUserId/correctedAt/correctionReason),
// not Part 2's original editedBy/editedAt/editReason draft.
//
// Deliberately NOT included yet (later batches only, once the thing
// that would ever set them actually exists): autoClosed (needs live-
// seeding's own "shift closed with no matching clock-out" detection),
// status/locking (needs PayPeriod), otApproved/appliedRates/
// hoursWorked/nightDiffHours/otHours/lateMinutes/undertimeMinutes
// (needs the rate/computation engine). Adding them now with nothing to
// ever write them would be exactly the kind of unwired dead field this
// batch's own predecessor got removed for.
model AttendanceRecord {
  id          String           @id @default(cuid())
  employeeId  String
  workDate    DateTime
  shiftId     String?
  clockIn     DateTime
  clockOut    DateTime?
  rawClockIn  DateTime
  rawClockOut DateTime?
  source      AttendanceSource @default(MANUAL)

  correctedByUserId String?
  correctedAt       DateTime?
  correctionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id])
  shift       Shift?   @relation(fields: [shiftId], references: [id])
  correctedBy User?    @relation(fields: [correctedByUserId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate])
}

// Payroll Batch 2b. Deliberately NOT modeled like CoachRate (flat,
// overwrite-in-place — services/coaching/coach-rate.service.ts) —
// payroll computation is retroactive/recomputable (an OPEN PayPeriod
// can be recomputed anytime, and a rate change in March must never
// alter an already-computed February day), which CoachRate's one-time
// snapshot-at-booking model has no equivalent need for. A new row is
// always inserted; an existing row is never edited or overwritten in
// place. "What rate applied on day Y" is derived at read time —
// the most recent row with effectiveFrom <= that day — never stored
// anywhere as a cached/denormalized value.
model EmployeeRate {
  id              String   @id @default(cuid())
  employeeId      String
  dailyRateCents  Int
  // Local calendar midnight, same convention as AttendanceRecord.workDate.
  effectiveFrom   DateTime
  note            String?
  createdAt       DateTime @default(now())
  createdByUserId String

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdBy User     @relation(fields: [createdByUserId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

enum PayPeriodStatus {
  OPEN
  // LOCKED is Batch 3 — deliberately not modeled yet, same "don't add
  // an unwired field/state" discipline AttendanceRecord's own comment
  // above already applies to itself. Only OPEN is ever produced or
  // transitioned to by anything in this batch.
}

// Semi-monthly (1st-15th, 16th-end of month), owner-confirmed cadence.
// No employeeId — a period is a shared calendar bucket, not a per-
// employee row; the computation engine (Batch 2c) joins period +
// employee at read time. Materialized lazily, on first access, by
// pay-period.service.ts's getOrCreatePeriodForDate — mirrors
// gcashReconciliationService.getOrCreateBalanceForDate exactly, except
// a PayPeriod carries no forward-dependent state (no "starting balance
// carried from yesterday"), so there's no correctness reason to
// pre-generate a year of these upfront the way that isn't true there
// either, just less pressing.
model PayPeriod {
  id        String          @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  status    PayPeriodStatus @default(OPEN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([startDate, endDate])
  @@index([startDate])
}

// Payroll Batch 2c. Deliberately the simplest possible shape — a date and
// a label, nothing else. No recurrence (a yearly holiday must be marked
// again next year), no regular-vs-special distinction, no multiplier
// field: this batch does NOT compute rest-day/holiday pay correctly, it
// only flags a worked day that falls on one of these dates
// (REST_DAY_OR_HOLIDAY_UNHANDLED, lib/payroll/compute-day.ts) so the owner
// can see it and adjust pay by hand. Getting the multiplier math right is
// Batch 3. Deleting a row is safe — computation writes nothing (rule 4 of
// the payroll plan), so there's no persisted number a deleted marker could
// retroactively corrupt.
model PayrollMarkedDate {
  id              String   @id @default(cuid())
  date            DateTime
  label           String
  createdAt       DateTime @default(now())
  createdByUserId String

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@unique([date])
}

// GCash reconciliation Gate 1. Deliberately date-scoped, NOT shift-
// scoped like Shift's own cash reconciliation — GCash is one shared
// account balance for the whole business, not a physical drawer handed
// off between individual staff shifts, so multiple shifts in one day
// all feed the SAME day's record rather than each getting their own.
// One row per calendar day (@@unique below), auto-created on demand
// with its startingBalanceCents carried forward from the most recent
// CONFIRMED day (services/gcash/gcash-reconciliation.service.ts) — not
// re-entered manually. The very first day ever has no prior CONFIRMED
// row to carry forward from; that's a one-time manual seed
// (seedFirstBalance), not silently defaulted to 0.
enum GcashDailyBalanceStatus {
  OPEN
  CONFIRMED
}

model GcashDailyBalance {
  id                          String                  @id @default(cuid())
  date                        DateTime                @unique
  startingBalanceCents        Int
  // Both null until confirmed. expectedEndingBalanceCents is a SNAPSHOT
  // taken at confirmation time (startingBalanceCents + that day's GCash
  // sales, as of that exact moment) — not a live-recomputed field,
  // same "written once, at close" shape as Shift.closingCashCents.
  expectedEndingBalanceCents  Int?
  confirmedEndingBalanceCents Int?
  // expected - confirmed... actually confirmed - expected, matching
  // Shift.varianceCents' own sign convention (positive = counted more
  // than expected). Required note when non-zero — enforced at the
  // service layer (only it knows the variance), not here.
  varianceCents               Int?
  notes                       String?
  status                      GcashDailyBalanceStatus @default(OPEN)
  confirmedByEmployeeId       String?
  confirmedAt                 DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  confirmedByEmployee Employee? @relation(fields: [confirmedByEmployeeId], references: [id])

  @@index([date])
  @@index([status])
}

// Cash's twin of GcashDailyBalance above — same day-scoped, one-shared-
// float shape (starting cash + today's Cash sales = expected, note
// required only when confirmed ≠ expected). Deliberately a separate
// model rather than a payment-method column on GcashDailyBalance: a
// generalized "PaymentMethodDailyBalance" would need its own migration
// of every existing GCash row and touch a real-money feature already in
// daily use, for a savings of a handful of near-identical fields. Not
// the same thing as Shift.openingCashCents/closingCashCents — that's a
// per-shift drawer handoff between employees; this is one running total
// for the whole business per day, same relationship GCash already has
// to Shift's own cash reconciliation (both exist, side by side).
enum CashDailyBalanceStatus {
  OPEN
  CONFIRMED
}

model CashDailyBalance {
  id                          String                 @id @default(cuid())
  date                        DateTime               @unique
  startingBalanceCents        Int
  expectedEndingBalanceCents  Int?
  confirmedEndingBalanceCents Int?
  // Cash physically pulled from the drawer at close (bank deposit/safe) —
  // set once, at confirm. Only confirmedEndingBalanceCents minus this
  // amount stays in the drawer, and it's THAT leftover that carries
  // forward as tomorrow's startingBalanceCents, not the full confirmed
  // count (see getOrCreateBalanceForDate) — the business pulls the bulk
  // of each day's cash out rather than leaving it sitting in the drawer
  // overnight.
  withdrawnCents              Int                    @default(0)
  varianceCents               Int?
  notes                       String?
  status                      CashDailyBalanceStatus @default(OPEN)
  confirmedByEmployeeId       String?
  confirmedAt                 DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  confirmedByEmployee Employee? @relation(fields: [confirmedByEmployeeId], references: [id])

  @@index([date])
  @@index([status])
}

// --- Court Management ------------------------------------------------------
// Court.status is the administrative toggle (Create/Edit/Disable Courts).
// CourtMaintenance is the scheduled-downtime history — a separate lifecycle
// from the court's live status.

enum CourtStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Owner request (2026-08-08): "block courts for a special event, shown
// publicly as 'Booked for special events' instead of the generic
// maintenance label." Extends CourtMaintenance rather than a new model
// — see CourtMaintenance's own comment for why: it's already exactly
// "a time window that occupies a court for a non-customer reason,"
// already wired into every conflict-detection path (create-time
// Serializable transaction, live preview, public grid, staff grid,
// open-play assignment). Default MAINTENANCE keeps every existing row
// unchanged.
enum CourtBlockKind {
  MAINTENANCE
  SPECIAL_EVENT
}

model Court {
  id                     String      @id @default(cuid())
  name                   String      @unique
  description            String?
  indoor                 Boolean     @default(true)
  status                 CourtStatus @default(ACTIVE)
  hourlyRateCents        Int?
  // Staff-only 30-minute walk-in slot (front-desk booking form, never
  // the public site) — a flat price per court, edited alongside
  // hourlyRateCents on the same Courts screen, same nullability
  // pattern deliberately NOT followed: this one is NOT NULL with a
  // real default (₱200) rather than nullable, since "unset" has no
  // sensible fallback the way a null hourly rate does elsewhere (a
  // court with no hourly rate just can't be booked hourly; a court
  // with no flat price would need one anyway the first time someone
  // tries to use it). Per-court, not a single venue-wide setting,
  // deliberately matching hourlyRateCents' own shape — even though all
  // three courts happen to share one price today, court pricing is
  // established as per-court data on this model, not a global CMS
  // setting (which would have been a category error: this has nothing
  // to do with open play).
  shortSessionPriceCents Int         @default(20000)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  maintenanceRecords   CourtMaintenance[]
  bookings             Booking[]
  openPlayQueueEntries OpenPlayQueue[]
  openPlayMatches      OpenPlayMatch[]
  openPlayQueueHistory OpenPlayQueueHistory[]
  matches              Match[]
  gameAssignments      GameAssignment[]

  @@index([status])
}

model CourtMaintenance {
  id          String            @id @default(cuid())
  courtId     String
  createdById String
  reason      String
  notes       String?
  startAt     DateTime
  endAt       DateTime
  status      MaintenanceStatus @default(SCHEDULED)
  // See CourtBlockKind's own comment. One row per court — a special
  // event blocking 3 courts is 3 rows sharing the same reason/window,
  // independently cancellable, same as if 3 separate maintenance
  // windows happened to be scheduled together.
  kind        CourtBlockKind    @default(MAINTENANCE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  court     Court @relation(fields: [courtId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([courtId, startAt, endAt])
  @@index([status])
  @@index([kind, startAt])
}

// --- Booking System ---------------------------------------------------------
// bookedById is who performed the booking action (a member, or a
// receptionist entering a walk-in). playerId is who it's for, and is
// nullable — a walk-in without a Player profile is captured via the
// guestName/guestPhone fields instead. parentBookingId links recurring
// instances to the series they belong to.

enum BookingType {
  HOURLY
  RECURRING
  WALK_IN
  PRIVATE
  MAINTENANCE_BLOCK
}

// Phase 8 plumbing: AWAITING_PAYMENT/PENDING_VERIFICATION/REJECTED/
// REFUNDED added for the public GCash-prepayment flow — same four
// values BUILD-SPEC.md §8's reconciliation already named for this exact
// purpose, matching OpenPlayNightRegistrationStatus's naming for the
// equivalent Fri/Sat flow. All four exist now but are unreachable from
// any service method until Gate 2 wires them in (same "reserved ahead of
// the service that uses it" shape as OpenPlayNightRegistrationStatus's
// own AWAITING_PAYMENT/PENDING_VERIFICATION — see that enum's comment).
// PENDING/PAID are pre-existing and untouched — still reserved, still
// unreachable, not repurposed for this flow (see booking-status.ts).
enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  REJECTED
  REFUNDED
}

// v1.2: an explicit field, not inferred at read time from Sale.source or
// bookedById. Both are proxies — Sale is a separate, nullable-linked row
// that may not exist for every booking, and bookedById points at a
// seeded system identity that requires knowing to check for it. Phase 8
// makes "staff bookings are exempt from prepayment" a server-side
// authorization decision, which must read a field on the booking being
// authorized, not walk a relation that might be missing. Set once, at
// creation, in createBooking — never updated afterward.
enum BookingSource {
  PUBLIC
  STAFF
  // Historical rows backfilled where Sale.source and bookedById
  // disagreed, or neither resolved (no linked Sale, e.g.) — see
  // scripts/backfill-booking-source.ts. Never set going forward; every
  // new booking gets PUBLIC or STAFF explicitly at creation.
  UNKNOWN
}

// bookingReference (added in Phase 4, a pre-approved exception to the
// Database freeze) is the human-friendly, stable identifier shown in UI/
// receipts/communication ("BK-YYYYMMDD-NNNN") — id stays the internal PK.
model Booking {
  id                String               @id @default(cuid())
  bookingReference  String               @unique
  courtId           String
  bookedById        String
  playerId          String?
  parentBookingId   String?
  type              BookingType
  status            BookingStatus        @default(PENDING)
  // @default(UNKNOWN) exists solely so the migration can add this as a
  // real NOT NULL column against existing rows — every application-level
  // write path sets it explicitly (createBooking) or resolves it
  // deliberately (the one-time backfill script), never relies on this
  // default going forward.
  source            BookingSource        @default(UNKNOWN)
  startAt           DateTime
  endAt             DateTime
  recurrenceRule    String?
  guestName         String?
  guestPhone        String?
  guestEmail        String?
  totalAmountCents  Int?
  qrCodeToken       String?              @unique
  notes             String?
  cancelledAt       DateTime?
  // v1.2 Phase 2: set when a staff/owner booking falls outside the
  // court's effective operating window (BUILD-SPEC.md §0 "Facility close
  // is a PUBLIC limit, not a data limit") — staff can always book past
  // hours, this just flags it for reporting. Always false for WEBSITE
  // bookings, since those are blocked outright instead of flagged.
  isAfterHours      Boolean              @default(false)
  // Phase 8 plumbing. Set only for the public GCash hold (status =
  // AWAITING_PAYMENT): now + 30 minutes at checkout start. Explicitly
  // set back to NULL the moment payment proof is submitted (status ->
  // PENDING_VERIFICATION) — a hold's expiry must never keep counting
  // once staff verification is what the booking is actually waiting on.
  // Any code that sweeps expired holds must scope its query to
  // status = AWAITING_PAYMENT (not just "holdExpiresAt is in the past"),
  // exactly like OpenPlayNightRegistration's equivalent window — belt
  // and suspenders, since NULL already can't be "in the past" through
  // any query, but the status scope is the actual source of truth.
  // Always NULL for STAFF bookings and any booking created before this
  // switch existed.
  holdExpiresAt     DateTime?
  // Real incident (2026-08-06): the public booking form's only
  // double-submit protection was a React disabled-state that isn't
  // atomic with the click — a fast double-tap (very plausible right
  // after switching back from the GCash app) could fire createBookingHold
  // twice for the same slot; one succeeded, the other legitimately
  // conflicted with the customer's OWN just-created hold, and whichever
  // response rendered last decided what the customer saw. One key,
  // generated once per client form session (features/bookings/
  // components/public-booking-form.tsx) — a second createBookingHold
  // call with the same key returns the FIRST call's booking instead of
  // racing the availability check. Nullable: only the public
  // prepayment-hold path sets this; staff bookings (createBooking) never
  // do.
  idempotencyKey    String?              @unique
  // Short booking code (2026-08-06, extended to staff bookings and
  // shortened to 5 chars the same day): an unambiguous code (no 0/O, 1/I/L — see
  // services/booking/booking-short-code.ts) shown to customers instead
  // of the full bookingReference — easier to read back over the phone
  // or off an SMS, including for a walk-in/phone booking staff create
  // on the customer's behalf. Every staff-facing surface (booking
  // detail/list, reports, coaching report) still shows bookingReference
  // as the primary id, unchanged — this is what's given TO the customer,
  // not a replacement for the internal reference. Set for every new
  // booking going forward, regardless of source — nullable only because
  // every pre-existing row is simply null, never backfilled.
  shortCode         String?              @unique
  // Settle-bill (pay-at-venue gap fix): a staff/pay-at-venue booking is
  // created with NO Sale and no assumed payment method — the customer's
  // actual method isn't known until they actually pay, which may be well
  // after booking time. These four mirror PlayerTab's own settlement
  // fields exactly (same TabSettlementMethod enum, same
  // gcashReference-required-when-GCASH shape, enforced at the service
  // layer) — "has this booking been paid" is `sale != null`, not a
  // BookingStatus value (PAID exists in the enum but has no reachable
  // transition anywhere in this app; not changed by this feature).
  // Always NULL for a WEBSITE booking, which pays through its own
  // separate GCash-hold-and-verify flow (BookingPaymentProof), not this
  // path.
  settledAt         DateTime?
  settledByUserId   String?
  settledVia        TabSettlementMethod?
  gcashReference    String?
  // Optional photo of the physical receipt/GCash confirmation, captured
  // at settle time — same private-upload mechanism as BookingPaymentProof
  // and Expense.receiptStorageKey, served only through the permission-
  // gated /api/booking-receipt/[key] route, never a public static path.
  // Null for any booking settled before this field existed, and always
  // for a WEBSITE booking (its proof is BookingPaymentProof, not this).
  receiptStorageKey String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  court           Court                 @relation(fields: [courtId], references: [id])
  bookedBy        User                  @relation("BookingBookedBy", fields: [bookedById], references: [id])
  settledBy       User?                 @relation("BookingSettledBy", fields: [settledByUserId], references: [id])
  player          Player?               @relation(fields: [playerId], references: [id])
  parentBooking   Booking?              @relation("BookingRecurrence", fields: [parentBookingId], references: [id])
  recurrences     Booking[]             @relation("BookingRecurrence")
  history         BookingHistory[]
  payments        Payment[]
  invoices        Invoice[]
  sale            Sale?
  // Phase 8 plumbing — see the models themselves, below Sale, for the
  // full shape and reasoning.
  paymentProofs   BookingPaymentProof[]
  creditsIssued   BookingCredit[]       @relation("BookingCreditSource")
  creditsRedeemed BookingCredit[]       @relation("BookingCreditRedemption")
  refunds         BookingRefund[]
  // v1.2 DRAFT: a court booking has at most one coach session attached
  // to it — see CoachSession.bookingId, the required/unique/cascading
  // side of this relation. Independent of status/source above — a
  // booking can carry a coach session through any point in the Phase 8
  // lifecycle (AWAITING_PAYMENT hold included; see coach-session.service.ts's
  // merge-time note on why creating a session doesn't require CONFIRMED).
  coachSession    CoachSession?
  // Add-ons (paddle rentals, shop items) for a court booking — see
  // BookingTab's own comment for the full shape and why it's a new
  // sibling model rather than a PlayerTab retrofit.
  bookingTab      BookingTab?

  @@index([courtId, startAt, endAt])
  @@index([status])
  @@index([playerId])
}

// Add-ons for a court booking (paddle rentals, shop items) — same
// running-tab shape as open play's PlayerTab (append-only line items,
// settle once for the total), but keyed to a Booking instead of an
// OpenPlayNightRegistration. A NEW sibling model, not a PlayerTab
// retrofit: PlayerTab.registrationId is required+unique, and every
// PlayerTab consumer (buildView's game-count query, computeGameRateCents,
// getOrCreateTab itself) assumes a registration exists — making that
// nullable to also accept a booking would ripple through code no
// open-play behavior asked to change. Deliberately independent of the
// booking's own court-fee Sale (Sale.bookingId) — a booking may already
// be GCash-prepaid for court time while add-ons are bought later at the
// desk, usually cash; settling this tab never touches or reopens that
// Sale. See Sale.bookingTabId's own comment for how settlement avoids
// repeating the exact revenue-misattribution bug open play's own
// PlayerTab settlement has (one lump Sale per settle, category OPEN_PLAY,
// so a PRODUCT-type add-on never shows up on the Shop Products report).
model BookingTab {
  id                 String               @id @default(cuid())
  bookingId          String               @unique
  status             PlayerTabStatus      @default(OPEN)
  settledAt          DateTime?
  settledByUserId    String?
  settledVia         TabSettlementMethod?
  // Required when settledVia = GCASH — same conditionally-required-at-
  // the-service-layer shape as PlayerTab.gcashReference.
  gcashReference     String?
  writeOffReason     String?
  // Required at the service layer for every write-off (§9's "no
  // anonymous write-offs," same rule PlayerTab already follows) —
  // nullable here only because Prisma can't make a column conditionally
  // required based on another column's value.
  writeOffEmployeeId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking          Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  writeOffEmployee Employee?            @relation(fields: [writeOffEmployeeId], references: [id])
  lineItems        BookingTabLineItem[]
  // No single `sale Sale?` back-relation here, unlike PlayerTab — a
  // BookingTab can produce SEVERAL Sales at settlement (one per distinct
  // product), see Sale.bookingTabId.
  sales            Sale[]

  @@index([status])
}

enum BookingTabLineItemType {
  PRODUCT
  // "Never edit or delete an existing line item" — voiding a charge is a
  // new, offsetting row of this type, not a mutation of the original.
  // Same shape as TabLineItem's own ADJUSTMENT — no GAME or RENTAL here:
  // a court booking has no games, and PlayerTab's own RENTAL type has no
  // UI caller anywhere in this codebase today (checked directly — not a
  // real precedent to replicate), so it's left out rather than built
  // unused.
  ADJUSTMENT
}

model BookingTabLineItem {
  id              String                 @id @default(cuid())
  tabId           String
  type            BookingTabLineItemType
  description     String
  qtyOrGames      Int
  unitPriceCents  Int
  amountCents     Int
  // Captured from day one — unlike open play's pre-existing TabLineItem,
  // which lacks this column entirely and is exactly why a PRODUCT-type
  // open-play add-on can't be traced back to a real Product row for the
  // Shop Products report. Set for type=PRODUCT; null for type=ADJUSTMENT
  // (a void has no product of its own — see voidsLineItemId below).
  productId       String?
  // Required for ADJUSTMENT (a void always carries a reason); null for
  // PRODUCT, which is self-explanatory.
  reason          String?
  createdByUserId String?
  createdAt       DateTime               @default(now())

  // Set only on a void (type=ADJUSTMENT) — points back to the line item
  // it offsets. The original row is never touched, so "never edit or
  // delete" stays literally true, same as TabLineItem.
  voidsLineItemId String?
  voidsLineItem   BookingTabLineItem?  @relation("BookingTabLineItemVoids", fields: [voidsLineItemId], references: [id])
  voidedByItems   BookingTabLineItem[] @relation("BookingTabLineItemVoids")

  tab     BookingTab @relation(fields: [tabId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([tabId])
  @@index([productId])
}

model BookingHistory {
  id          String        @id @default(cuid())
  bookingId   String
  status      BookingStatus
  note        String?
  changedById String?
  createdAt   DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([bookingId])
}

// --- Coaching Sessions --------------------------------------------------
// DRAFT — schema-only, Gate 1 (revised per review). Modeled deliberately
// on the Booking system above: same status flow (CoachSessionStatus
// mirrors BookingStatus value-for-value — CONFIRMED is what
// "confirmed-unpaid" means today, same as a court booking; PAID/
// CHECKED_IN exist now so Phase 8 can wire prepayment through this flow
// without a schema change), an explicit source field set at creation
// (never inferred, same reasoning as Booking.source), and
// Sale.coachSessionId below is a nullable slot Phase 8 will populate —
// nothing writes to it this round. A distinct enum/model set rather than
// literally reusing Booking's, matching this schema's own convention
// (every status enum here belongs to exactly one model — see
// MaintenanceStatus/PlayerTabStatus/etc. — not shared cross-model), but
// the VALUES are intentionally identical, not independently designed.
//
// Structural rule (review, Gate 1): a CoachSession cannot exist without a
// parent court Booking — bookingId is required, unique (a Booking has at
// most one CoachSession), and onDelete: Cascade (deleting the court
// booking removes its coach session, no orphan enforced by the DB, not
// app logic). date/time/court are NOT duplicated on CoachSession — they
// live on the parent Booking and are read through the relation. One
// source of truth for "when."
//
// Deliberately NOT modeled: recurrence (Booking's parentBookingId/
// recurrenceRule) — coach availability is explicitly specific-date, not
// recurring, and nothing in this round asked for a recurring session
// series.

enum CoachSessionStatus {
  PENDING
  CONFIRMED
  PAID
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Same reasoning as BookingSource — set once at creation, never inferred.
enum CoachSessionSource {
  PUBLIC
  STAFF
  UNKNOWN
}

// sessionReference: same human-facing pattern as Booking.bookingReference
// ("CS-YYYYMMDD-NNNN" via the shared lib/reference-counter.ts), generated
// in the service layer — not part of this schema-only gate.
model CoachSession {
  id                    String             @id @default(cuid())
  sessionReference      String             @unique
  // Required, unique, cascading — see the section comment above. The
  // "coach session with no court" state is unrepresentable, not just
  // application-code-prevented.
  bookingId             String             @unique
  coachId               String
  bookedById            String
  playerId              String?
  groupSize             Int
  // Snapshotted from CoachRate at creation — same lesson as
  // TabLineItem.unitPriceCents: editing the rate table later must never
  // rewrite a session that already booked at the old price.
  rateCents             Int
  status                CoachSessionStatus @default(PENDING)
  source                CoachSessionSource @default(UNKNOWN)
  // Same reasoning as Booking.isAfterHours: staff/owner may book a coach
  // outside that coach's stated CoachAvailabilityWindow entries; the
  // public path may not (blocked outright, same as the public booking
  // form already blocks outside-hours court bookings). This just flags
  // it for reporting when staff used the override. Always false for a
  // PUBLIC-sourced session, since those never reach this point without
  // already passing the availability-window check.
  isOutsideAvailability Boolean            @default(false)
  guestName             String?
  guestPhone            String?
  guestEmail            String?
  notes                 String?
  cancelledAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  booking  Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coach    Employee              @relation("CoachSessionsCoached", fields: [coachId], references: [id])
  bookedBy User                  @relation(fields: [bookedById], references: [id])
  player   Player?               @relation(fields: [playerId], references: [id])
  history  CoachSessionHistory[]
  sale     Sale?

  // No independent [coachId, startAt, endAt] index — there's no
  // independent startAt/endAt anymore. The concurrency guard's overlap
  // check (item 2, not built yet) queries through the booking relation,
  // which already carries Booking's own [courtId, startAt, endAt] index;
  // this index scopes "which of this coach's sessions" once joined.
  @@index([coachId])
  @@index([status])
  @@index([playerId])
}

model CoachSessionHistory {
  id             String             @id @default(cuid())
  coachSessionId String
  status         CoachSessionStatus
  note           String?
  changedById    String?
  createdAt      DateTime           @default(now())

  coachSession CoachSession @relation(fields: [coachSessionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id])

  @@index([coachSessionId])
}

// Specific open dates/times a coach has made themselves bookable —
// deliberately NOT a recurring weekly template. Everything outside a
// window is closed by default; a booking must fall inside one (item 3,
// not built yet). One row per contiguous window, same shape as
// CourtMaintenance's [startAt, endAt] pair, just opposite polarity
// (CourtMaintenance blocks; this grants).
model CoachAvailabilityWindow {
  id        String   @id @default(cuid())
  coachId   String
  startAt   DateTime
  endAt     DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach Employee @relation("CoachAvailabilityWindows", fields: [coachId], references: [id])

  @@index([coachId, startAt, endAt])
}

// Owner-editable group-size -> price table (item 1), PER COACH (review:
// confirmed, not facility-wide — two owners, rates differ by person). A
// real table, not the CMS "Other rates" JSON blob (that's marketing copy
// for the public rates page, not a transactional lookup
// CoachSession.rateCents needs FK-clean integrity against).
model CoachRate {
  id         String   @id @default(cuid())
  coachId    String
  groupSize  Int
  priceCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  coach Employee @relation("CoachRates", fields: [coachId], references: [id])

  @@unique([coachId, groupSize])
}

// --- Membership --------------------------------------------------------
// MembershipPlan is a real table (not an enum), same precedent as
// Role/Permission — the five named tiers are seeded rows, not hardcoded
// values, so a plan can be added or changed without a code change.

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

model MembershipPlan {
  id              String        @id @default(cuid())
  name            String        @unique
  description     String?
  priceCents      Int
  billingPeriod   BillingPeriod
  discountPercent Float?
  priorityBooking Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberships       Membership[]
  membershipHistory MembershipHistory[]
}

// membershipReference (Phase 7, a pre-approved exception to the Database
// freeze, same precedent as Booking.bookingReference/
// OpenPlaySession.sessionReference) is the human-friendly, stable
// identifier shown in UI/history ("MB-YYYYMMDD-NNNN") — id stays the
// internal PK.
model Membership {
  id                  String           @id @default(cuid())
  membershipReference String           @unique
  playerId            String
  membershipPlanId    String
  status              MembershipStatus @default(PENDING)
  startDate           DateTime
  endDate             DateTime
  autoRenew           Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  player         Player              @relation(fields: [playerId], references: [id])
  membershipPlan MembershipPlan      @relation(fields: [membershipPlanId], references: [id])
  payments       Payment[]
  invoices       Invoice[]
  history        MembershipHistory[]
  sale           Sale?

  @@index([playerId])
  @@index([status])
  @@index([endDate])
}

// Append-only log of every enrollment/renewal/plan-change/suspension/
// reactivation/cancellation/expiration event a membership goes through
// (Phase 7, a pre-approved exception, same shape as BookingHistory).
// Suspension has no dedicated MembershipStatus value (that enum is
// frozen) — a suspended membership's status is CANCELLED, distinguished
// from a permanent cancellation only by this log's eventType.
enum MembershipHistoryEventType {
  ENROLLED
  RENEWED
  UPGRADED
  DOWNGRADED
  SUSPENDED
  REACTIVATED
  CANCELLED
  EXPIRED
}

model MembershipHistory {
  id               String                     @id @default(cuid())
  membershipId     String
  eventType        MembershipHistoryEventType
  membershipPlanId String?
  note             String?
  changedById      String?
  createdAt        DateTime                   @default(now())

  membership     Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  membershipPlan MembershipPlan? @relation(fields: [membershipPlanId], references: [id])
  changedBy      User?           @relation(fields: [changedById], references: [id])

  @@index([membershipId])
  @@index([createdAt])
}

// --- Open Play -----------------------------------------------------------
// OpenPlayRegistration is a player's (or walk-in guest's) registration/
// waitlist status for a session (unique per session+player, guests
// identified by nullable playerId + guestName/guestPhone — same walk-in
// pattern as Booking). OpenPlayQueue is the separate, real-time in-session
// rotation (Waiting/Playing/Resting) — it only exists once a registration
// has checked in, and points at OpenPlayRegistration (never Player
// directly) so a queue entry's identity always comes from one source of
// truth whether it's a player or a guest.
//
// sessionReference (Phase 5, a pre-approved exception to the Database
// freeze, same precedent as Booking.bookingReference) is the human-
// friendly, stable identifier shown in UI/reports ("OP-YYYYMMDD-NNNN").
//
// OpenPlayMatch/OpenPlayMatchParticipant (Phase 5) record match history:
// one row per match started via RotationEngine.startNextMatch, with which
// registrations played in it — an audit trail that also lays the
// groundwork for future player statistics without further schema changes.
//
// OpenPlayQueueHistory (Phase 5) is an append-only log of every
// Waiting/Playing/Resting transition a queue entry goes through, enabling
// future analytics (total waiting time, total playing time) without a
// schema change later.

enum OpenPlaySessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OpenPlayRegistrationStatus {
  REGISTERED
  WAITLISTED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

enum OpenPlayQueueStatus {
  WAITING
  PLAYING
  RESTING
}

model OpenPlaySession {
  id               String                @id @default(cuid())
  sessionReference String                @unique
  title            String?
  startAt          DateTime
  endAt            DateTime
  capacity         Int
  status           OpenPlaySessionStatus @default(SCHEDULED)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  registrations OpenPlayRegistration[]
  queueEntries  OpenPlayQueue[]
  matches       OpenPlayMatch[]

  @@index([startAt, endAt])
  @@index([status])
}

model OpenPlayRegistration {
  id                String                     @id @default(cuid())
  openPlaySessionId String
  playerId          String?
  guestName         String?
  guestPhone        String?
  status            OpenPlayRegistrationStatus @default(REGISTERED)
  registeredAt      DateTime                   @default(now())
  checkedInAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  openPlaySession     OpenPlaySession            @relation(fields: [openPlaySessionId], references: [id])
  player              Player?                    @relation(fields: [playerId], references: [id])
  queueEntry          OpenPlayQueue?
  matchParticipations OpenPlayMatchParticipant[]

  @@unique([openPlaySessionId, playerId])
  @@index([status])
}

model OpenPlayQueue {
  id                String              @id @default(cuid())
  openPlaySessionId String
  registrationId    String              @unique
  courtId           String?
  status            OpenPlayQueueStatus @default(WAITING)
  queuePosition     Int
  stateChangedAt    DateTime            @default(now())
  joinedAt          DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  openPlaySession OpenPlaySession        @relation(fields: [openPlaySessionId], references: [id])
  registration    OpenPlayRegistration   @relation(fields: [registrationId], references: [id])
  court           Court?                 @relation(fields: [courtId], references: [id])
  history         OpenPlayQueueHistory[]

  @@index([openPlaySessionId, queuePosition])
  @@index([status])
  @@index([courtId])
}

model OpenPlayQueueHistory {
  id         String              @id @default(cuid())
  queueId    String
  status     OpenPlayQueueStatus
  courtId    String?
  occurredAt DateTime            @default(now())
  createdAt  DateTime            @default(now())

  queue OpenPlayQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  court Court?        @relation(fields: [courtId], references: [id])

  @@index([queueId, occurredAt])
}

model OpenPlayMatch {
  id                String    @id @default(cuid())
  openPlaySessionId String
  courtId           String
  matchNumber       Int
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  completedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  openPlaySession OpenPlaySession            @relation(fields: [openPlaySessionId], references: [id])
  court           Court                      @relation(fields: [courtId], references: [id])
  completedBy     User?                      @relation(fields: [completedByUserId], references: [id])
  participants    OpenPlayMatchParticipant[]

  @@unique([openPlaySessionId, matchNumber])
}

model OpenPlayMatchParticipant {
  id             String   @id @default(cuid())
  matchId        String
  registrationId String
  createdAt      DateTime @default(now())

  match        OpenPlayMatch        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registration OpenPlayRegistration @relation(fields: [registrationId], references: [id])

  @@unique([matchId, registrationId])
}

// --- Open Play Nights (BUILD-SPEC.md §4) -----------------------------------
// Deliberately separate from OpenPlaySession/OpenPlayRegistration above,
// which power a different feature entirely (a live, same-day drop-in
// rotation queue — register, waitlist, check in, get called to a match,
// rest, repeat; currently off behind FEATURE_OPEN_PLAY). This is a
// recurring Friday/Saturday capacity-limited, prepaid, waitlisted night —
// different lifecycle, different status vocabulary, no rotation/queue/
// match concept at all. Reusing the existing models would mean overloading
// their status enums with unrelated meanings; two clearly-named, separate
// models is the safer path against a schema with a "changes need
// precedent" convention.

enum OpenPlayNightStatus {
  OPEN
  CLOSED
  CANCELLED
}

// Seed: Friday(5) 32, Saturday(6) 40 — owner-editable, no upper cap
// enforced (BUILD-SPEC.md §4 "Accept any positive integer").
model OpenPlayCapacityDefault {
  id                        String   @id @default(cuid())
  dayOfWeek                 Int
  capacity                  Int
  // Open-play online self-registration, Gate 1 follow-up (BUILD-SPEC.md
  // §6): which capacity nights actually offer online registration — a
  // NARROWER question than "which nights are capacity nights at all."
  // That broader question is still hardcoded to Friday/Saturday
  // (OPEN_PLAY_DAYS_OF_WEEK in open-play-capacity.service.ts, plus the
  // DB-level CHECK constraint in migration 11/12) and stays that way;
  // this column doesn't touch it. This is the second, independent gate:
  // even once services/settings.getOpenPlayOnlineRegistrationEnabled()
  // (the feature-wide switch) is on, a specific weekday's online
  // registration only actually offers itself if this is ALSO true for
  // that day — both gates must pass. Defaults true (not false, unlike
  // the feature-wide switch) because it changes nothing on its own: the
  // feature-wide switch is what actually gates reachability, defaulting
  // false. This column merely states which days WOULD be offered once
  // that switch is flipped, and "Friday and Saturday" is the accurate
  // default answer today, backfilling true for both already-seeded rows
  // when this column is added — an owner who later wants online
  // registration on Friday only turns this off for Saturday specifically,
  // rather than every deployment needing to opt both days back in after
  // enabling the feature.
  onlineRegistrationEnabled Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([dayOfWeek])
}

// One row per calendar date, created on demand from the weekday default
// (see OpenPlayCapacityService.getOrCreateSessionForDate) — not
// pre-populated for every future Friday/Saturday. capacity is copied from
// the default at creation time (or set directly via an owner override) and
// is authoritative for that date from then on; it does not track later
// changes to the weekday default.
model OpenPlayNightSession {
  id                        String              @id @default(cuid())
  date                      DateTime
  startAt                   DateTime
  endAt                     DateTime
  // Owner request (2026-08-08): "sometimes we want open play at earlier
  // times." False for every date until staff explicitly edit this
  // date's start time — startAt is otherwise just a snapshot of the
  // live fridaySaturdayCloseTime setting at session-creation time, same
  // as before this field existed. Only once true does
  // getCourtBookingWindow treat THIS date's startAt as the real,
  // enforced court-booking cutoff instead of recomputing from the
  // global setting — deliberately opt-in per date, not "any existing
  // session row is an override" (unlike capacity, which already works
  // that way): a session row already gets auto-created just from staff
  // visiting the admin capacity page, long before this field existed,
  // and silently freezing THOSE rows' cutoff at whatever the global
  // setting happened to be that day would be a real, surprising
  // regression the moment the global setting is later changed.
  startAtOverridden         Boolean             @default(false)
  capacity                  Int
  status                    OpenPlayNightStatus @default(OPEN)
  // Date-specific override, independent of both the feature-wide switch
  // and OpenPlayCapacityDefault.onlineRegistrationEnabled's day-of-week
  // default — e.g. "this particular Friday is a tournament, no online
  // registration that night" even though Fridays are normally open.
  // Walk-in/staff registration is untouched by this; it only gates
  // createPublicOpenPlayRegistration.
  onlineRegistrationBlocked Boolean             @default(false)
  // Per-date closed-registration message, shown on every public surface
  // in place of the global default (settingsService's OpenPlaySettings.
  // closedRegistrationMessage) when this date is blocked. Null (not "")
  // means "use the global default" — the resolver trims and treats a
  // whitespace-only value the same as null, so there's no way to end up
  // showing a blank message block. Independent of onlineRegistrationBlocked
  // on purpose: an owner can write the message ahead of time and flip the
  // block switch on later, or leave a message parked for a date that was
  // never actually blocked.
  closedMessage             String?             @db.VarChar(200)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  registrations   OpenPlayNightRegistration[]
  queueEntries    QueueEntry[]
  gameAssignments GameAssignment[]
  tabs            PlayerTab[]
  // Open-play online self-registration, Gate 1 plumbing — see
  // OpenPlayWaitlistEntry, below QueueEntry. Fri/Sat only (this model's
  // own required sessionId enforces that — weeknight is uncapped, so
  // "waitlist" is meaningless there; see OpenPlayWaitlistEntry's comment).
  waitlistEntries OpenPlayWaitlistEntry[]

  @@unique([date])
  @@index([status])
}

// BUILD-SPEC.md §5/§6. Phase 4 only builds the staff walk-in path — cash
// paid immediately, so status lands on CONFIRMED directly (no
// AWAITING_PAYMENT/PENDING_VERIFICATION hold). Those two values existed
// unused until online self-registration Gate 1 (BUILD-SPEC.md §6, "PARKED"
// subsection) — this is where they get used for real. "Confirmed but no
// seat" (paid, waiting for capacity) is waitlistPos being non-null,
// independent of status — a waitlisted walk-in still has status=CONFIRMED
// (they paid), just no seat yet. See
// services/open-play/open-play-registration.service.ts for the exact
// capacity-counting predicate. This is a DIFFERENT concept from
// OpenPlayWaitlistEntry (below QueueEntry) — that one is for an online
// registrant who has NOT paid and holds no registration row at all yet.
//
// REJECTED added in the same Gate 1 pass, mirroring Booking's exact
// reasoning (services/booking/booking-status.ts's comment): a staff-
// rejected bad GCash proof is a different real-world event from a
// customer's own CANCELLED, and conflating them the way this enum did
// before (there was no REJECTED) would have forced Gate 2's reject
// action to reuse CANCELLED and lose that distinction.
enum OpenPlayNightRegistrationStatus {
  AWAITING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  CHECKED_OUT
  NO_SHOW
  CANCELLED
  REJECTED
}

enum OpenPlayNightRegistrationSource {
  WALK_IN
  WEBSITE
}

model OpenPlayNightRegistration {
  id            String                          @id @default(cuid())
  // Nullable — BUILD-SPEC.md §0: weeknight open play needs no capacity, no
  // waitlist, no prepayment, but still needs registration/check-in/queue
  // rows like Fri/Sat does. Fri/Sat registrations always have a session
  // (capacity-gated); weeknight registrations never do (uncapped) — `date`
  // is the field both cases set, so every read path can group/query by
  // night without a session join. PlayerTab (§9, Phase 7) follows the same
  // date-keyed, nullable-sessionId shape for the same reason.
  sessionId     String?
  date          DateTime
  playerId      String?
  playerName    String
  phone         String
  skillLevel    OpenPlaySkillLevel
  source        OpenPlayNightRegistrationSource
  status        OpenPlayNightRegistrationStatus @default(CONFIRMED)
  // Non-null means "on the waitlist, this position" — null means "has a
  // seat." Independent of `status` (see enum comment above). Always null
  // for weeknight (uncapped, never waitlisted).
  waitlistPos   Int?
  // Optional group tag (BUILD-SPEC.md §7) — a party enters the queue only
  // once every member with this partyId has checked in (§6).
  partyId       String?
  registeredAt  DateTime                        @default(now())
  // BUILD-SPEC.md §6 "Check-in... sets checkedInAt" — null until check-in.
  // Queue position derives from this, never registeredAt.
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  // Open-play online self-registration, Gate 1 plumbing. Mirrors
  // Booking.holdExpiresAt exactly, including the "nulled on submission"
  // rule (see that column's comment in schema.prisma) — set only when a
  // waitlist invite creates this row at status=AWAITING_PAYMENT, cleared
  // the moment proof is submitted (status -> PENDING_VERIFICATION), and
  // always NULL for WALK_IN registrations and any registration created
  // before this Gate existed. Same "lazy exclusion, no active sweep"
  // reasoning as the court-booking hold: nothing sweeps an expired,
  // unresolved hold back to a terminal status automatically — the
  // separate OpenPlayWaitlistEntry.status (below QueueEntry) is what
  // actually decides whether the freed invite passes to the next person,
  // independent of whether this registration row itself ever changes.
  holdExpiresAt DateTime?
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  session               OpenPlayNightSession?              @relation(fields: [sessionId], references: [id])
  player                Player?                            @relation(fields: [playerId], references: [id])
  queueEntry            QueueEntry?
  gameAssignmentEntries GameAssignmentParticipant[]
  tab                   PlayerTab?
  // The Fri/Sat ₱150 registration fee's own Sale row — WALK_IN only for
  // now (registerWalkIn), created in the same transaction as this row.
  // Distinct from `tab`/PlayerTab.sale (the weeknight game/rental
  // settlement path) — this registration never has both.
  sale                  Sale?
  // Open-play online self-registration, Gate 1 plumbing.
  paymentProofs         OpenPlayRegistrationPaymentProof[]
  // The waitlist entry that was invited-to-pay and became this row, if
  // any — null for a WALK_IN registration or a direct (non-waitlisted)
  // WEBSITE registration. The inverse of OpenPlayWaitlistEntry.registrationId.
  waitlistEntry         OpenPlayWaitlistEntry?
  // Cancellation policy Gate 1 — mirrors Booking's creditsIssued/
  // creditsRedeemed/refunds exactly (see BookingCredit/BookingRefund,
  // below Sale).
  creditsIssued         OpenPlayCredit[]                   @relation("OpenPlayCreditSource")
  creditsRedeemed       OpenPlayCredit[]                   @relation("OpenPlayCreditRedemption")
  refunds               OpenPlayRefund[]
  // Not expressible in schema.prisma — Prisma has no CHECK-constraint or
  // trigger syntax, so these are hand-written into
  // prisma/migrations/11_registration_session_constraints/migration.sql
  // (+ a timezone fix in 12_fix_registration_weekday_check_timezone/,
  // see BUILD-SPEC.md §0 "Timezone: date-only values assume TZ=Asia/Manila")
  // and invisible to `prisma migrate diff`. Any future migration touching
  // this table must NOT let a plain `migrate diff` silently drop them —
  // check the migration.sql by hand. Enforced at write time (INSERT/
  // UPDATE), not just read time:
  //   1. A CHECK constraint: Friday/Saturday (date's day-of-week 5 or 6,
  //      evaluated against date + 8 hours — see migration 12) requires
  //      sessionId NOT NULL; every other day requires it NULL.
  //   2. A BEFORE INSERT/UPDATE trigger: when sessionId is set, `date`
  //      must equal that session's own `date` column (can't be expressed
  //      as a CHECK constraint — it reads a different table).

  @@index([sessionId, status])
  @@index([sessionId, waitlistPos])
  @@index([date])
}

enum QueueEntryStatus {
  WAITING
  PLAYING
  RESTING
  DONE
}

// Created at check-in, not at registration (BUILD-SPEC.md §6 "Check-in is
// what enters a player into the queue — not registration"). One per
// registration (@@unique below makes check-in naturally idempotent — see
// OpenPlayCheckinService.checkIn). Populated here in Phase 5; consumed by
// auto-pairing/GameAssignment in Phase 6, not built yet.
model QueueEntry {
  id             String             @id @default(cuid())
  registrationId String             @unique
  sessionId      String?
  date           DateTime
  playerName     String
  skillLevel     OpenPlaySkillLevel
  partyId        String?
  joinedQueueAt  DateTime
  status         QueueEntryStatus   @default(WAITING)
  gamesPlayed    Int                @default(0)
  lastPlayedAt   DateTime?
  // Staging pipeline (Next up/After that/Then, reported live: "staff need
  // to compose the staging slots, not just watch them fill"). Null means
  // "not staged" — plain WAITING. Non-null points at the StagedGroup this
  // entry currently belongs to; membership IS "QueueEntry rows pointing
  // at this StagedGroup," no separate join table. Deliberately does NOT
  // change joinedQueueAt or queue order — staging is an orthogonal flag,
  // not a reorder, which is what makes "un-stage returns you to your
  // existing position, not the bottom" true for free (see
  // unstageQueueEntry's own comment).
  stagedGroupId  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  registration OpenPlayNightRegistration @relation(fields: [registrationId], references: [id])
  session      OpenPlayNightSession?     @relation(fields: [sessionId], references: [id])
  stagedGroup  StagedGroup?              @relation(fields: [stagedGroupId], references: [id])

  @@index([date, status])
  @@index([sessionId, status])
  @@index([stagedGroupId])
}

enum StagedGroupSlot {
  NEXT_UP
  AFTER_THAT
  THEN
}

enum StagedGroupSource {
  MANUAL
  AUTO_QUEUE
}

// Staging pipeline (reported live): a REAL, saved group waiting for a
// court — not a live-recomputed preview of the top of the queue (the
// previous "Next up" behavior). Staff fill a slot either by Auto Queue
// (strict FIFO, same selection rule Quick-queue already uses) or Build by
// hand (the existing manual picker, targeting a slot instead of a court).
// @@unique([date, slot]) is the "one group per slot per night" guard
// (requirement 7: filling an occupied slot is a clean rejection, never a
// silent overwrite or fallthrough — same "fail clean" precedent as
// assignPendingGroupToCourt's occupied-court check). Scoped by date, not
// sessionId — the rotation queue already pools regular and unlimited
// registrations on the same date (see the Fri/Sat pooling comment on
// fetchWaitingUnits), so the staging pipeline matches that same scope.
model StagedGroup {
  id              String            @id @default(cuid())
  date            DateTime
  slot            StagedGroupSlot
  source          StagedGroupSource
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  queueEntries QueueEntry[]

  @@unique([date, slot])
}

// --- Open-play online self-registration (BUILD-SPEC.md §6, "PARKED"
// subsection) — Gate 1: schema only. Nothing below is reachable from any
// service or route yet; every field is either nullable or has a safe
// default, so this migration changes zero existing runtime behavior.
// Same "plumbing only" shape as Phase 8's own Gate 1
// (18_phase8_prepayment_plumbing) — mirrored deliberately, including the
// naming: OpenPlayRegistrationPaymentProof is BookingPaymentProof's exact
// shape, field for field, against OpenPlayNightRegistration instead of
// Booking.
//
// Deliberately a SEPARATE model, not a polymorphic BookingPaymentProof
// (nullable bookingId + nullable registrationId + a type discriminator).
// BookingPaymentProof is shipped, live, and read by Gate 3's verification
// queue with an unconditional `booking: { include: { court: true } } }`
// — making its own FK nullable would touch that already-proven code for
// no benefit. Two small, duplicate models cost less than one shared,
// invasive one — same reasoning this codebase already applies elsewhere
// (see booking.service.ts's toJsonValue comment). Whether the Gate 3
// verification-queue UI can still show both proof types in one list, or
// needs its own tab/filter, is a real open question — reported
// separately, not decided here (see the Gate 1 report, not the schema).
enum OpenPlayRegistrationPaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model OpenPlayRegistrationPaymentProof {
  id                   String                                 @id @default(cuid())
  registrationId       String
  // Same fraud-check shape as BookingPaymentProof.gcashReference — see
  // that field's comment. Uniqueness is scoped (partial index, hand-
  // written in migration.sql) to PENDING/APPROVED only, not REJECTED,
  // for the identical "a rejected screenshot must be resubmittable"
  // reason. NOT scoped across BookingPaymentProof — a reference reused
  // between a court booking and an open-play registration would not be
  // caught by either table's own index alone. Flagged as a real,
  // accepted gap in the Gate 1 report; not fixed here (closing it would
  // mean touching BookingPaymentProof's own shipped submission path,
  // outside this Gate's hard boundary).
  // Nullable as of migration 38 — mirrors BookingPaymentProof's own
  // gcashReference (migration 32): removed from the customer-facing
  // upload entirely (the screenshot IS the proof; retyping a reference
  // between apps was pure friction), staff can still record one manually
  // at verification. No change needed to the partial unique index
  // (OpenPlayRegistrationPaymentProof_gcashReference_active_key,
  // migration 21) — Postgres never treats two NULLs as equal for
  // uniqueness, same reasoning migration 32 already documented.
  gcashReference       String?
  screenshotStorageKey String
  submittedAmountCents Int
  submittedAt          DateTime                               @default(now())
  status               OpenPlayRegistrationPaymentProofStatus @default(PENDING)
  resolvedByEmployeeId String?
  resolvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime                               @default(now())
  updatedAt            DateTime                               @updatedAt

  registration       OpenPlayNightRegistration @relation(fields: [registrationId], references: [id])
  resolvedByEmployee Employee?                 @relation(fields: [resolvedByEmployeeId], references: [id])

  @@index([registrationId])
  @@index([status])
}

enum OpenPlayWaitlistEntryStatus {
  // Not yet invited — sitting in FCFS order (submittedAt) behind
  // whoever's ahead. The only status a brand-new online registrant on a
  // full night ever starts in.
  WAITING
  // A slot freed and this entry is next; a real OpenPlayNightRegistration
  // (status=AWAITING_PAYMENT, holdExpiresAt=now+30min) has been created
  // and linked via registrationId. Waiting on GCash proof.
  INVITED
  // Default assumption, stated explicitly per the spec's own "state
  // explicitly if a different rule is wanted" convention — NOT
  // confirmed with the business: the invite window lapsed with no proof
  // submitted. Terminal for this entry — it does not silently return to
  // WAITING for a second chance. If a returning-to-the-back behavior is
  // wanted instead, that's a one-line change to the transition table
  // below, flagged here so it isn't missed.
  EXPIRED
  // The invite was paid and verified in time — registrationId now
  // points at a CONFIRMED (or still PENDING_VERIFICATION) registration.
  // Terminal, success case.
  CONVERTED
}

// A queue of online registrants for a full Fri/Sat night who have NOT
// paid and hold no OpenPlayNightRegistration row at all yet — distinct
// from OpenPlayNightRegistration.waitlistPos (a *paid* walk-in with no
// seat, see that field's comment). sessionId is required, not nullable
// the way OpenPlayNightRegistration.sessionId is: a waitlist only exists
// where capacity does, and weeknight open play is uncapped (BUILD-SPEC.md
// §0) — no session, no waitlist concept. Fri/Sat only, confirmed in the
// Gate 1 report, not assumed silently.
model OpenPlayWaitlistEntry {
  id              String                      @id @default(cuid())
  sessionId       String
  playerName      String
  // Required, not optional — the whole reason this exists is the SMS
  // invite (BUILD-SPEC.md §6), which has nowhere to go without one.
  phone           String
  skillLevel      OpenPlaySkillLevel
  submittedAt     DateTime                    @default(now())
  status          OpenPlayWaitlistEntryStatus @default(WAITING)
  // Both null until INVITED; both stay set (not cleared) once EXPIRED or
  // CONVERTED — an audit trail of when the invite went out and when it
  // was due, unlike Booking.holdExpiresAt which nulls on submission
  // (that one guards a live availability check; this one doesn't gate
  // anything once the entry leaves INVITED, so there's no equivalent
  // reason to clear it).
  invitedAt       DateTime?
  inviteExpiresAt DateTime?
  // Set once INVITED (points at the real hold this entry produced) —
  // null in WAITING, never unset afterward, even if the entry later
  // reaches EXPIRED (the dead registration stays linked for the audit
  // trail; see its own holdExpiresAt comment on why nothing sweeps it).
  registrationId  String?                     @unique
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  session      OpenPlayNightSession       @relation(fields: [sessionId], references: [id])
  registration OpenPlayNightRegistration? @relation(fields: [registrationId], references: [id])

  // The FCFS scan ("who's next") queries exactly this shape: this
  // session's still-WAITING entries, oldest submittedAt first.
  @@index([sessionId, status, submittedAt])
}

// --- Rotation queue and pairing (BUILD-SPEC.md §7) --------------------------
// Distinctly named from the old, dormant OpenPlayMatch/OpenPlayMatchParticipant
// above (same reasoning as OpenPlayNightSession vs OpenPlaySession) — this
// consumes QueueEntry rows from the current (non-dormant) Open Play Nights
// feature, not the old OpenPlaySession rotation system. GameAssignment /
// GameAssignmentParticipant mirror OpenPlayMatch / OpenPlayMatchParticipant's
// join-table shape for referential integrity, without reusing either name.

enum GameAssignmentSource {
  AUTO
  MANUAL
}

enum GameAssignmentStatus {
  PROPOSED
  ACTIVE
  DONE
  CANCELLED
}

model GameAssignment {
  id                      String               @id @default(cuid())
  courtId                 String
  // Nullable for the same reason as OpenPlayNightRegistration.sessionId —
  // weeknight rotation has no session to key off. `date` is what every
  // query groups by; sessionId is populated for Fri/Sat only.
  sessionId               String?
  date                    DateTime
  // Max skill-level distance among this game's 4 participants at proposal
  // time (0 = all same level). Informational — not enforced, just shown to
  // staff and useful for later tuning of skillWindow.
  skillSpread             Int
  source                  GameAssignmentSource
  createdByUserId         String?
  proposedAt              DateTime             @default(now())
  startedAt               DateTime?
  endedAt                 DateTime?
  // Stamped by the ANNOUNCE staff action (open-play-rotation.service.ts's
  // announceAssignment) — re-pressable, and deliberately independent of
  // startedAt/status: announcing (players walk over) and starting the
  // 15-minute clock (players are on court) are two separate staff
  // decisions, not one bundled "confirm" step. The TV display watches
  // this value changing, not the assignment's status, to decide when to
  // speak.
  announcementRequestedAt DateTime?
  // Manual "Time's up" call — same shape as announcementRequestedAt
  // above, but for calling players OFF the court instead of onto it.
  // Deliberately manual, not clock-driven: staff can see whether players
  // noticed and already left, so an automatic call would fire whether or
  // not it's actually needed. Available while ACTIVE only (never
  // PROPOSED — there's no "time" to be up before a game has even
  // started); re-pressable, same as ANNOUNCE. The one-minute warning
  // stays separate and automatic (settings.service.ts's
  // getGameWarningSettings) — that one is purely clock-driven with no
  // human judgment involved, this one is the opposite.
  timesUpRequestedAt      DateTime?
  status                  GameAssignmentStatus @default(PROPOSED)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  court        Court                       @relation(fields: [courtId], references: [id])
  session      OpenPlayNightSession?       @relation(fields: [sessionId], references: [id])
  createdBy    User?                       @relation(fields: [createdByUserId], references: [id])
  participants GameAssignmentParticipant[]
  tabLineItems TabLineItem[]

  @@index([date, status])
  @@index([courtId, status])
  @@index([sessionId])
}

// Always exactly 4 rows per assignment (BUILD-SPEC.md §7 "doubles only —
// every game assigns exactly 4 players") — enforced in
// open-play-rotation.service.ts, not at the database level (a CHECK
// constraint can't count sibling rows; a trigger could, but four
// application-validated inserts inside one transaction is the same
// guarantee this codebase already accepts elsewhere, e.g. party size 2-4).
model GameAssignmentParticipant {
  id             String   @id @default(cuid())
  assignmentId   String
  registrationId String
  createdAt      DateTime @default(now())

  assignment   GameAssignment            @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  registration OpenPlayNightRegistration @relation(fields: [registrationId], references: [id])

  @@unique([assignmentId, registrationId])
  @@index([registrationId])
}

// Soft repeat-avoidance tiebreak (BUILD-SPEC.md §7 "Never a hard
// constraint"). Adapted from the spec's playerIdA/playerIdB naming to
// registrationIdA/registrationIdB — guests (the common case) have no
// Player.id, but every participant always has an OpenPlayNightRegistration.
// date-scoped, not sessionId-scoped, so it works for weeknight pairs too.
// The service is responsible for always storing the pair in a consistent
// order (e.g. lexicographically smaller id first) so a repeat pairing
// increments one row instead of creating a mirrored duplicate.
model RecentPairing {
  id              String   @id @default(cuid())
  date            DateTime
  registrationIdA String
  registrationIdB String
  gameCount       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([date, registrationIdA, registrationIdB])
  @@index([date])
}

// --- Player tabs, settlement (BUILD-SPEC.md §9) -----------------------------
// Same date-keyed, nullable-sessionId fork as OpenPlayNightRegistration and
// GameAssignment, and for the same reason — weeknight tabs are exactly the
// ones that carry money and weeknights have no session to key off. One tab
// per registration (a player's whole night), created on demand the first
// time it's needed (checkIn, or a game/rental credit if check-in somehow
// didn't). Settlement creates a Sale row (SaleCategory.OPEN_PLAY) through
// the existing SaleService — same Employee+Shift-backed revenue path every
// other module uses, not a parallel one.

enum PlayerTabStatus {
  OPEN
  SETTLED
  WRITTEN_OFF
}

enum TabLineItemType {
  GAME
  RENTAL
  ADJUSTMENT
  // Open-play queue/tabs screen batch: "+ Add-on" (Water/Shirt/Ball/Grip/
  // Paddle Rental, sourced from the Product catalog, editable there) —
  // distinct from RENTAL, which stays Equipment-sourced and untouched
  // (addRentalLineItem/addRentalLineItemAction have real test/service
  // dependencies elsewhere and are not being removed).
  PRODUCT
}

enum TabSettlementMethod {
  CASH
  GCASH
}

model PlayerTab {
  id                 String               @id @default(cuid())
  date               DateTime
  sessionId          String? // nullable — Fri/Sat only, same fork as OpenPlayNightRegistration.sessionId
  registrationId     String               @unique
  playerName         String
  // Snapshotted at tab creation (BUILD-SPEC.md §9 "Prices snapshot at
  // transaction time"): the current weeknightGameRateCents setting for a
  // weeknight tab, or 0 for Fri/Sat (games "counted for rotation fairness,
  // billed at ₱0" — the flat ₱150 fee is a separate, not-yet-built §8
  // payment, not a tab line item).
  gameRateCents      Int
  status             PlayerTabStatus      @default(OPEN)
  settledAt          DateTime?
  settledByUserId    String?
  settledVia         TabSettlementMethod?
  // Required when settledVia = GCASH — same "unique across all payments"
  // fraud check §8 already specifies, enforced at the service layer since
  // it's conditionally required, not a plain column constraint.
  gcashReference     String?
  writeOffReason     String?
  // Required at the service layer for every write-off (BUILD-SPEC.md §9
  // review: "no anonymous write-offs") — nullable here only because
  // Prisma has no way to make a column conditionally required based on
  // another column's value (status = WRITTEN_OFF); enforced in
  // player-tab.service.ts's writeOffTab, same pattern as writeOffReason.
  writeOffEmployeeId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  registration     OpenPlayNightRegistration @relation(fields: [registrationId], references: [id])
  session          OpenPlayNightSession?     @relation(fields: [sessionId], references: [id])
  writeOffEmployee Employee?                 @relation(fields: [writeOffEmployeeId], references: [id])
  lineItems        TabLineItem[]
  sale             Sale?

  @@index([date, status])
  @@index([sessionId])
}

// Append-only (BUILD-SPEC.md §9 "Never edit or delete an existing line
// item") — a correction is a new ADJUSTMENT row, a voided charge is a new
// negative-amount row that offsets the original, never a mutation.
model TabLineItem {
  id               String          @id @default(cuid())
  tabId            String
  type             TabLineItemType
  description      String
  qtyOrGames       Int
  unitPriceCents   Int
  amountCents      Int
  // Traceability for GAME items back to the completed game that generated
  // them. NOT database-unique on (tabId, gameAssignmentId) — see
  // voidsLineItemId below for why: a voided GAME credit must not
  // permanently block a legitimate later credit for the same assignment.
  // creditGame enforces "don't double-credit a still-active game" itself,
  // at the application level, by checking for an existing, non-voided
  // GAME row before inserting. That check is only safe under concurrency
  // because its one caller (open-play-rotation.service.ts's
  // completeAssignment) takes a `SELECT ... FOR UPDATE` lock on the
  // GameAssignment row first — see that method's comment, and
  // player-tab.concurrency.integration.ts, which fires concurrent
  // completeAssignment calls against one assignment and asserts exactly
  // one credit lands.
  gameAssignmentId String?
  // Required for ADJUSTMENT (§9 "a required reason, logged with who made
  // it"); null for GAME/RENTAL, which are self-explanatory.
  reason           String?
  createdByUserId  String?
  createdAt        DateTime        @default(now())

  // Set only on a void adjustment (type=ADJUSTMENT) — points back to the
  // line item it offsets. Purely additive: the original row is never
  // touched, so "never edit or delete an existing line item" (§9) stays
  // literally true. This is what lets creditGame tell "already credited,
  // still active" apart from "credited, then fully voided — free to
  // credit again."
  voidsLineItemId String?
  voidsLineItem   TabLineItem?  @relation("LineItemVoids", fields: [voidsLineItemId], references: [id])
  voidedByItems   TabLineItem[] @relation("LineItemVoids")

  tab            PlayerTab       @relation(fields: [tabId], references: [id], onDelete: Cascade)
  gameAssignment GameAssignment? @relation(fields: [gameAssignmentId], references: [id])

  @@index([tabId])
  @@index([tabId, gameAssignmentId])
  @@index([voidsLineItemId])
}

// --- Tournament System -----------------------------------------------------
// TournamentCategory separates the bracket `format` (how matches are
// structured) from `division` (who's eligible) so e.g. "Mixed Doubles,
// Round Robin" and "Men's Singles, Single Elimination" are both expressible.
// Match.tournamentCategoryId is nullable so match recording isn't
// permanently tied to tournaments only, matching "Match History" being
// listed under Player Profiles independently of tournament history.

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  ROUND_ROBIN
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  POOL_PLAY
}

enum TournamentDivision {
  MENS
  WOMENS
  MIXED
  OPEN
}

enum TournamentRegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  WITHDRAWN
  DISQUALIFIED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  WALKOVER
}

model Tournament {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  createdById           String
  status                TournamentStatus @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  venueInfo             String?
  // Owner request (2026-08-05): some tournaments run as an outside event
  // where entrants already paid the organizers directly — registering a
  // team here shouldn't require an open shift or record a Sale at all.
  // Defaults true so every existing tournament keeps today's behavior
  // (register a team, require a shift, record a real Sale) unchanged.
  collectsPaymentOnSite Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  createdBy  User                 @relation(fields: [createdById], references: [id])
  categories TournamentCategory[]

  @@index([status])
  @@index([startDate])
}

model TournamentCategory {
  id           String             @id @default(cuid())
  tournamentId String
  name         String
  format       TournamentFormat
  division     TournamentDivision
  skillLevel   SkillLevel?
  feeCents     Int                @default(0)
  maxTeams     Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  tournament    Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registrations TournamentRegistration[]
  matches       Match[]

  @@index([tournamentId])
}

model TournamentRegistration {
  id                   String                       @id @default(cuid())
  tournamentCategoryId String
  teamId               String
  status               TournamentRegistrationStatus @default(PENDING)
  seed                 Int?
  registeredAt         DateTime                     @default(now())
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  // Optional — same private-upload mechanism already used for
  // Expense.receiptStorageKey (services/upload/), not a second upload
  // path. Null when staff didn't attach one at registration time.
  receiptStorageKey    String?

  tournamentCategory TournamentCategory @relation(fields: [tournamentCategoryId], references: [id], onDelete: Cascade)
  team               Team               @relation(fields: [teamId], references: [id])
  payments           Payment[]
  invoices           Invoice[]
  sale               Sale?

  @@unique([tournamentCategoryId, teamId])
  @@index([status])
}

model Match {
  id                   String      @id @default(cuid())
  tournamentCategoryId String?
  courtId              String?
  round                Int?
  bracketPosition      Int?
  team1Id              String
  team2Id              String?
  winnerTeamId         String?
  status               MatchStatus @default(SCHEDULED)
  scheduledAt          DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tournamentCategory TournamentCategory? @relation(fields: [tournamentCategoryId], references: [id])
  court              Court?              @relation(fields: [courtId], references: [id])
  team1              Team                @relation("MatchTeam1", fields: [team1Id], references: [id])
  team2              Team?               @relation("MatchTeam2", fields: [team2Id], references: [id])
  winnerTeam         Team?               @relation("MatchWinnerTeam", fields: [winnerTeamId], references: [id])
  scores             Score[]

  // Phase 10, a pre-approved exception: a DB-level backstop against
  // match.service.ts's tryAdvanceBracket creating the same next-round slot
  // twice under concurrent completion of both sibling matches (the
  // application-layer check-then-write race that Serializable transactions
  // also guard against — this constraint holds even if that guard were
  // ever bypassed). Safe on nullable columns: non-bracket matches (null
  // tournamentCategoryId/round/bracketPosition) don't collide, since
  // Postgres treats each NULL as distinct for uniqueness.
  @@unique([tournamentCategoryId, round, bracketPosition])
  @@index([tournamentCategoryId])
  @@index([status])
  @@index([team1Id])
  @@index([team2Id])
  @@index([winnerTeamId])
}

model Score {
  id         String   @id @default(cuid())
  matchId    String
  setNumber  Int
  team1Score Int
  team2Score Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
}

// --- Equipment Rentals -----------------------------------------------------
// Equipment is physical inventory (paddles/balls/ball machines), tracked as
// a pooled quantity, not per-unit serials. Rentals are per-item
// transactions; maintenance logs are an append-only history per item.
// rentalReference (Phase 8, a pre-approved exception, same precedent as
// Booking.bookingReference) is the human-friendly id ("ER-YYYYMMDD-NNNN").

enum EquipmentType {
  PADDLE
  BALL
  BALL_MACHINE
}

enum EquipmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum RentalStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

// Shared by EquipmentMaintenanceLog and LockerMaintenanceLog (Phase 8, a
// pre-approved exception). resolvedAt is nullable — an unresolved
// DAMAGE_REPORT/ROUTINE/REPAIR/REPLACEMENT entry is what the computed
// condition/status functions treat as "currently under maintenance" or
// "currently damaged."
enum MaintenanceLogType {
  ROUTINE
  DAMAGE_REPORT
  REPAIR
  REPLACEMENT
}

model Equipment {
  id                    String          @id @default(cuid())
  name                  String          @unique
  // Stable identifier for equipment the app references programmatically
  // (e.g. the public site's paddle-rental price) — nullable because most
  // equipment rows are just admin-managed inventory nothing looks up by
  // identity. Renaming `name` in the admin UI must never break a lookup
  // by `key`, which is the whole point of having both.
  key                   String?         @unique
  type                  EquipmentType
  status                EquipmentStatus @default(AVAILABLE)
  condition             String?
  quantity              Int             @default(1)
  depositCents          Int             @default(0)
  rentalRateCents       Int             @default(0)
  // Reported live: a small, fully-owned pool (e.g. a Ball Machine the
  // venue owns exactly 2 of) permanently tripped inventoryAlertsService's
  // LOW_STOCK check at full availability — "2 of 2 available" isn't
  // actually low stock. MAINTENANCE/RETIRED already suppress the alert,
  // but marking an item MAINTENANCE to silence a false alarm is a
  // workaround, not a real fix, for an item that's genuinely in service.
  // Owner-editable per item (equipment edit form) rather than a global
  // on/off (services/settings/settings.service.ts's
  // getEquipmentHideLowStockAlert) so silencing one item's false alarm
  // doesn't also silence a real low-stock warning on everything else.
  lowStockAlertDisabled Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  rentals         EquipmentRental[]
  maintenanceLogs EquipmentMaintenanceLog[]

  @@index([type])
  @@index([status])
}

model EquipmentRental {
  id               String       @id @default(cuid())
  rentalReference  String       @unique
  equipmentId      String
  playerId         String
  bookingId        String?
  status           RentalStatus @default(ACTIVE)
  rentedAt         DateTime     @default(now())
  dueAt            DateTime?
  returnedAt       DateTime?
  depositPaidCents Int          @default(0)
  lateFeeCents     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  player    Player    @relation(fields: [playerId], references: [id])
  payments  Payment[]
  sale      Sale?

  @@index([status])
  @@index([playerId])
  @@index([equipmentId])
}

model EquipmentMaintenanceLog {
  id            String             @id @default(cuid())
  equipmentId   String
  logType       MaintenanceLogType @default(ROUTINE)
  note          String
  performedAt   DateTime
  performedById String?
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedBy User?     @relation(fields: [performedById], references: [id])

  @@index([equipmentId])
}

// --- Lockers -----------------------------------------------------------
// qrCodeToken is nullable and unused until the "Future QR support" bullet
// under this module is implemented — the column exists now so that phase
// doesn't require a schema change. rentalReference (Phase 8, a
// pre-approved exception) mirrors EquipmentRental.rentalReference
// ("LR-YYYYMMDD-NNNN").

enum LockerStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  DISABLED
}

enum LockerRentalType {
  DAILY
  MONTHLY
}

enum LockerRentalStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Locker {
  id        String       @id @default(cuid())
  code      String       @unique
  status    LockerStatus @default(AVAILABLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  rentals         LockerRental[]
  maintenanceLogs LockerMaintenanceLog[]

  @@index([status])
}

model LockerRental {
  id              String             @id @default(cuid())
  rentalReference String             @unique
  lockerId        String
  playerId        String
  type            LockerRentalType
  status          LockerRentalStatus @default(ACTIVE)
  startAt         DateTime
  endAt           DateTime
  amountCents     Int                @default(0)
  qrCodeToken     String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  locker   Locker    @relation(fields: [lockerId], references: [id])
  player   Player    @relation(fields: [playerId], references: [id])
  payments Payment[]
  sale     Sale?

  @@index([status])
  @@index([playerId])
  @@index([lockerId])
}

// New in Phase 8 — Lockers had no maintenance tracking at all until this
// phase (unlike Equipment, which had EquipmentMaintenanceLog since Phase
// 2). Same shape, same MaintenanceLogType enum.
model LockerMaintenanceLog {
  id            String             @id @default(cuid())
  lockerId      String
  logType       MaintenanceLogType @default(ROUTINE)
  note          String
  performedAt   DateTime
  performedById String?
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())

  locker      Locker @relation(fields: [lockerId], references: [id], onDelete: Cascade)
  performedBy User?  @relation(fields: [performedById], references: [id])

  @@index([lockerId])
}

// --- Payments & Invoices -----------------------------------------------
// Payment is the actual transaction record; Invoice is the billing
// document a payment can be applied against. Both use the same set of
// nullable references to whatever they're for (booking, membership,
// tournament registration, equipment rental, locker rental) rather than a
// stringly-typed polymorphic association, so referential integrity is
// enforced by the database. `purpose` on Payment is a fast discriminator
// for reporting without needing to check which FK is set.

enum PaymentPurpose {
  BOOKING
  MEMBERSHIP
  TOURNAMENT
  EQUIPMENT_RENTAL
  LOCKER_RENTAL
  OTHER
}

// PaymentMethod became a real, admin-editable table in v1.1 Sub-phase 2
// (was a hardcoded enum until then, matching zero live usage — Payment
// below was, and remains, unused by any service/action). Seeded with
// Cash/GCash/Bank Transfer/Credit-Debit Card; Owner can add/disable/
// reorder without a code change.
model PaymentMethod {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  payments Payment[]
  expenses Expense[]

  @@index([isActive, sortOrder])
}

// Expenses tracking Gate 1 — money going OUT (rent, supplies, utilities,
// anything the business pays), previously untracked anywhere in this app
// (confirmed absent by direct investigation — the only prior mention of
// "expense" in the whole repo was BUILD-SPEC.md's own "not in scope" note).
// Same "real, owner-editable list with sensible defaults" pattern as
// PaymentMethod above, not a hardcoded enum — an owner can add/rename/
// disable categories from its own admin panel.
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([isActive, sortOrder])
}

model Expense {
  id                   String   @id @default(cuid())
  // "EXP-20260722-0001" — same date + per-day-sequence pattern as every
  // other human-facing reference code in this app (Sale, Shift, Booking).
  expenseNumber        String   @unique
  amountCents          Int
  // The business date the expense applies to — staff-entered, may differ
  // from createdAt (e.g. recording a rent payment a day after it cleared).
  date                 DateTime
  // Required regardless of whether a receipt is attached — "what was this
  // for" must always be answerable from the row itself.
  description          String
  categoryId           String
  paymentMethodId      String
  recordedByEmployeeId String
  // Optional — same private-upload mechanism already built for payment-
  // proof screenshots (services/upload/), not a second upload path.
  // Null when no receipt was attached.
  receiptStorageKey    String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category           ExpenseCategory @relation(fields: [categoryId], references: [id])
  paymentMethod      PaymentMethod   @relation(fields: [paymentMethodId], references: [id])
  recordedByEmployee Employee        @relation(fields: [recordedByEmployeeId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@index([paymentMethodId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

model Payment {
  id                       String         @id @default(cuid())
  userId                   String
  purpose                  PaymentPurpose
  bookingId                String?
  membershipId             String?
  tournamentRegistrationId String?
  equipmentRentalId        String?
  lockerRentalId           String?
  invoiceId                String?
  amountCents              Int
  currency                 String         @default("PHP")
  paymentMethodId          String
  status                   PaymentStatus  @default(PENDING)
  providerReference        String?
  paidAt                   DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  booking                Booking?                @relation(fields: [bookingId], references: [id])
  membership             Membership?             @relation(fields: [membershipId], references: [id])
  tournamentRegistration TournamentRegistration? @relation(fields: [tournamentRegistrationId], references: [id])
  equipmentRental        EquipmentRental?        @relation(fields: [equipmentRentalId], references: [id])
  lockerRental           LockerRental?           @relation(fields: [lockerRentalId], references: [id])
  invoice                Invoice?                @relation(fields: [invoiceId], references: [id])
  paymentMethod          PaymentMethod           @relation(fields: [paymentMethodId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([purpose])
}

model Invoice {
  id                       String        @id @default(cuid())
  invoiceNumber            String        @unique
  userId                   String
  bookingId                String?
  membershipId             String?
  tournamentRegistrationId String?
  status                   InvoiceStatus @default(DRAFT)
  subtotalCents            Int
  taxCents                 Int           @default(0)
  totalCents               Int
  issuedAt                 DateTime?
  dueAt                    DateTime?
  paidAt                   DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  booking                Booking?                @relation(fields: [bookingId], references: [id])
  membership             Membership?             @relation(fields: [membershipId], references: [id])
  tournamentRegistration TournamentRegistration? @relation(fields: [tournamentRegistrationId], references: [id])
  payments               Payment[]

  @@index([userId])
  @@index([status])
}

// --- Sales (v1.1 Sub-phase 2 — Unified Sales Engine) ------------------------
// Sale is the single record every revenue-producing workflow creates,
// through SaleService, never by hand — Booking/Membership/EquipmentRental/
// LockerRental/TournamentRegistration each get exactly one, via their own
// nullable+unique FK below (same "one FK per source domain" shape Payment
// already established). employeeId/shiftId are both required: a Sale can
// only be created by a signed-in Employee with a currently OPEN Shift —
// this is what finally lets Shift.varianceCents be computed (closingCash -
// (openingCash + cash Sales for that shift)), though that computation
// itself is a later sub-phase, not built here.
enum SaleCategory {
  BOOKING
  MEMBERSHIP
  EQUIPMENT_RENTAL
  LOCKER_RENTAL
  TOURNAMENT_REGISTRATION
  PRODUCT
  // BUILD-SPEC.md §9 — a settled PlayerTab (games + rentals + adjustments,
  // net of write-offs, which are never revenue) via Sale.playerTabId, OR
  // the Fri/Sat ₱150 walk-in registration fee via
  // Sale.openPlayNightRegistrationId (Gate 2 review follow-up) — two
  // distinct linked-record shapes under one category, never both on the
  // same Sale row.
  OPEN_PLAY
  // Coaching sessions (v1.2 DRAFT) — reserved alongside
  // Sale.coachSessionId below for when Phase 8 wires payment through
  // coaching. Nothing creates a Sale with this category yet; coaching
  // sessions launch this round with no payment step at all.
  COACHING
  OTHER
}

// Only RECEPTION is produced by any workflow today — the rest exist so
// a future Customer Portal / Mobile App / Tournament kiosk can create
// Sales through the same SaleService without a schema change.
enum SaleSource {
  RECEPTION
  WEBSITE
  MOBILE_APP
  ADMIN
  TOURNAMENT
}

enum SaleStatus {
  COMPLETED
  VOID
}

model Sale {
  id              String       @id @default(cuid())
  // "SALE-20260722-0001" — same date + per-day-sequence pattern as every
  // other human-facing reference code in this app.
  saleNumber      String       @unique
  category        SaleCategory
  source          SaleSource   @default(RECEPTION)
  status          SaleStatus   @default(COMPLETED)
  amountCents     Int
  // Free-text context for categories with no source row (PRODUCT/OTHER) —
  // every other category's detail lives on its own linked record.
  description     String?
  notes           String?
  paymentMethodId String
  employeeId      String
  shiftId         String
  playerId        String?

  bookingId                   String? @unique
  coachSessionId              String? @unique
  membershipId                String? @unique
  equipmentRentalId           String? @unique
  lockerRentalId              String? @unique
  tournamentRegistrationId    String? @unique
  // NOT unique, unlike every field above it — those all back-reference a
  // one-time transaction row (a specific Booking, a specific
  // EquipmentRental instance, etc.), so "one Sale per X" is correct there.
  // productId instead points at the reusable Product catalog row itself
  // (services/products/product.service.ts's sellProduct sets it to the
  // same catalog id on every sale) — a `@unique` here made it impossible
  // to ever sell the same retail item twice, confirmed live (a second
  // sale of an already-sold product threw a real unique-constraint
  // violation). See migration 29_sale_product_id_not_unique.
  productId                   String?
  playerTabId                 String? @unique
  // Gate 2 review follow-up: the Fri/Sat ₱150 walk-in registration fee
  // (services/open-play/open-play-registration.service.ts's
  // registerWalkIn) — a SaleCategory.OPEN_PLAY Sale, but distinct from
  // playerTabId above (the weeknight/Fri-Sat game+rental settlement
  // path). A single OpenPlayNightRegistration only ever has one or the
  // other kind of Sale, never both — a Fri/Sat walk-in's tab (if it
  // ever gets one, e.g. equipment rental) settles with its OWN,
  // separate Sale via playerTabId, same as today.
  openPlayNightRegistrationId String? @unique
  // NOT unique — deliberately the same shape as productId above, and for
  // the identical reason. A BookingTab settlement (services/booking/
  // booking-tab.service.ts) creates ONE Sale PER DISTINCT PRODUCT rather
  // than one lump Sale for the whole tab, specifically so add-on revenue
  // lands on the correct category (PRODUCT, with productId set) instead
  // of being invisible to the Shop Products report the way open play's
  // PlayerTab settlement (one Sale, category OPEN_PLAY, no productId)
  // already is — see BookingTab's own schema comment. A `@unique` here
  // would make it impossible to ever settle a tab with two different
  // add-ons on it, the same failure productId's own unique constraint
  // hit before migration 29.
  bookingTabId                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner request (2026-08-08): a real, audit-logged correction path for
  // when an attendant records a Cash payment as GCash (or the reverse) —
  // see saleService.correctPaymentMethod's own comment. Same "columns on
  // the row + a single audit log entry" shape as PlayerTab's
  // writeOffReason/writeOffEmployeeId (no separate child table) — the
  // BEFORE payment method lives in the audit log's oldValues, not
  // duplicated here. Null on every sale that's never been corrected.
  paymentMethodCorrectedAt           DateTime?
  paymentMethodCorrectionReason      String?
  paymentMethodCorrectedByEmployeeId String?

  paymentMethod             PaymentMethod              @relation(fields: [paymentMethodId], references: [id])
  employee                  Employee                   @relation(fields: [employeeId], references: [id])
  shift                     Shift                      @relation(fields: [shiftId], references: [id])
  player                    Player?                    @relation(fields: [playerId], references: [id])
  booking                   Booking?                   @relation(fields: [bookingId], references: [id])
  coachSession              CoachSession?              @relation(fields: [coachSessionId], references: [id])
  membership                Membership?                @relation(fields: [membershipId], references: [id])
  equipmentRental           EquipmentRental?           @relation(fields: [equipmentRentalId], references: [id])
  lockerRental              LockerRental?              @relation(fields: [lockerRentalId], references: [id])
  tournamentRegistration    TournamentRegistration?    @relation(fields: [tournamentRegistrationId], references: [id])
  product                   Product?                   @relation(fields: [productId], references: [id])
  playerTab                 PlayerTab?                 @relation(fields: [playerTabId], references: [id])
  openPlayNightRegistration OpenPlayNightRegistration? @relation(fields: [openPlayNightRegistrationId], references: [id])
  bookingTab                BookingTab?                @relation(fields: [bookingTabId], references: [id])
  paymentMethodCorrectedByEmployee Employee?            @relation("SalePaymentMethodCorrectedBy", fields: [paymentMethodCorrectedByEmployeeId], references: [id])

  @@index([category])
  @@index([createdAt])
  @@index([employeeId])
  @@index([shiftId])
  @@index([playerId])
  @@index([productId])
  @@index([bookingTabId])
}

// --- Phase 8 plumbing: GCash prepayment for public court bookings ---------
// BUILD-SPEC.md §8 "Court bookings — prepayment REQUIRED on the public
// site, Phase 8". The switch that turns this flow on for the public is a
// Setting row (owner-only, §15's existing "Owner-only payment settings"
// rule) — no schema change needed for it, it's built in Gate 2. Nothing
// here is reachable from any service yet.

// One row per submission, not per booking — a rejected submission is not
// deleted or overwritten (append-only, same reasoning as TabLineItem):
// resubmission after a REJECTED proof creates a NEW row, so the full
// history of every attempt against a booking stays visible to staff.
// "Which proof is the live one" is whichever row has status = PENDING
// (at most one per booking at a time — enforced at the service layer,
// Gate 2, not the schema).
enum BookingPaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model BookingPaymentProof {
  id                   String                    @id @default(cuid())
  bookingId            String
  // Fraud check (§8 "unique across all payments"): NOT a plain @unique
  // here on purpose — a customer whose proof was rejected for a bad
  // screenshot (not a bad payment) must be able to resubmit the SAME
  // reference number for the SAME booking. The real invariant is
  // narrower than "this string appears once in the whole table, ever":
  // it's "no reference may be PENDING or APPROVED more than once,
  // anywhere" — REJECTED rows don't count. Prisma has no partial/
  // conditional unique index syntax, so this is a hand-written partial
  // unique index (`WHERE status IN ('PENDING','APPROVED')`) in
  // prisma/migrations/18_phase8_prepayment_plumbing/migration.sql,
  // invisible to `prisma migrate diff` — same pattern and same warning
  // as OpenPlayNightRegistration's hand-written CHECK constraint/trigger
  // (see that model's comment). Any future migration touching this
  // table must not let a plain `migrate diff` silently drop it.
  // Nullable as of migration 32 — the customer-facing upload step
  // treats the reference as optional as long as a screenshot is
  // attached (the screenshot IS the proof; the reference is a
  // convenience for staff to look the transaction up in the GCash
  // app faster). Postgres unique indexes never consider NULL equal to
  // another NULL, so multiple NULL-reference proofs coexisting as
  // PENDING/APPROVED never collide against this same partial index —
  // no WHERE-clause change needed alongside the column becoming
  // nullable.
  gcashReference       String?
  // The storage-interface key returned by UploadService.uploadPrivate()
  // (services/upload/upload-service.interface.ts) — never a directly-
  // servable public URL. Retrieval goes through getSignedUrl()/get(), so
  // the production (Spaces) swap can gate access instead of serving a
  // guessable-but-unauthenticated static path. See that interface for
  // the full public/private distinction and why it's a separate method
  // from the pre-existing upload() rather than a flag on it (zero risk
  // to the one existing caller, CMS gallery uploads).
  screenshotStorageKey String
  // Gate 3 gap, found and fixed while building the verification screen
  // Gate 1 always intended: "flag when the submitted amount doesn't
  // match what's owed" (§8) requires an actual stored number to compare
  // against Booking.totalAmountCents — Gate 1's field list never
  // included one. What the customer states they sent, at submission
  // time — compared against the booking's totalAmountCents for the
  // verification screen's mismatch flag, never trusted as proof of
  // actual payment on its own (that's what the screenshot is for).
  submittedAmountCents Int
  // Reported live 2026-08-04 (Bea Señeris, BK-20260804-0002): Expected
  // was recomputed live on every page load, so a coach added or
  // removed after submission silently changed what a proof was
  // compared against, with no record of what it originally was. Frozen
  // at submission via getExpectedPaymentTotalCents(booking)
  // (lib/booking-payment-total.ts), inside the same transaction as
  // submittedAmountCents — never touched again after insert. Nullable:
  // rows created before this column existed have no true historical
  // value to backfill (we never captured it), so they stay null and
  // read as "predates snapshot" rather than a guessed/backfilled
  // number. The approval gate (approveBookingPaymentProof) deliberately
  // keeps comparing against the LIVE total, not this snapshot — a real
  // current discrepancy must still surface even if this differs from
  // it; the detail screen shows BOTH when they disagree instead of
  // picking one.
  expectedAmountCents  Int?
  submittedAt          DateTime                  @default(now())
  status               BookingPaymentProofStatus @default(PENDING)
  // Nullable for the same reason PlayerTab.writeOffEmployeeId is —
  // required at the service layer (Gate 2's verification action, via
  // requireEmployee, same mechanism as write-offs/settlements — not a
  // new one), not expressible as a conditional-on-status column
  // constraint. NULL while status = PENDING; both set together the
  // moment staff approve or reject.
  resolvedByEmployeeId String?
  resolvedAt           DateTime?
  // Required at the service layer when status = REJECTED (same
  // conditional-requiredness shape as PlayerTab.writeOffReason). NULL
  // for PENDING and APPROVED.
  rejectionReason      String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  booking            Booking   @relation(fields: [bookingId], references: [id])
  resolvedByEmployee Employee? @relation(fields: [resolvedByEmployeeId], references: [id])

  @@index([bookingId])
  @@index([status])
}

// Cancelling a court booking before the cutoff converts its prepaid fee
// to credit instead of cash — same non-refundable-but-not-punitive shape
// BUILD-SPEC.md §8 specs for Fri/Sat open play (OpenPlayCredit, not yet
// built), applied here to bookings per this phase's explicit instruction
// to extend that decided policy shape to court bookings — the previously
// open "court bookings' own cancellation/refund policy" question (§17)
// is resolved by that instruction, not by this model alone; BUILD-SPEC.md
// needs updating to reflect it (flagged in the Gate 1 report, not done
// silently here).
//
// expiresAt is nullable, but no longer for "undecided" reasons — Gate 2
// review resolved it: 60 days from issue is the default a credit gets
// (services/booking/booking-credit.service.ts sets this explicitly on
// every normal issuance, not a Postgres column default — same "snapshot
// values in application code" convention as gameRateCents/
// totalAmountCents elsewhere in this schema). NULL is kept reachable
// specifically for a staff-granted no-expiry exception — an explicit
// override, not the default path. Note this landed on 60 days, not
// OpenPlayCredit's still-undecided proposed 90 — the two credit
// mechanisms are not required to match, and don't right now.
model BookingCredit {
  id          String    @id @default(cuid())
  // Matches OpenPlayCredit's proposed shape and the existing
  // returning-player lookup convention (WalkInRegistrationForm) — tied
  // to the phone number that made the original booking, not a User/
  // Player id, since a public booking's real customer identity is
  // guestPhone, not always a registered Player.
  phone       String
  amountCents Int
  reason      String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?

  sourceBookingId String
  sourceBooking   Booking  @relation("BookingCreditSource", fields: [sourceBookingId], references: [id])
  usedByBookingId String?
  usedByBooking   Booking? @relation("BookingCreditRedemption", fields: [usedByBookingId], references: [id])

  @@index([phone])
  @@index([sourceBookingId])
}

// A REAL cash refund for the business's OWN error (wrongly-rejected valid
// payment, genuine double payment, a staff-cancelled booking) — never
// reachable from customer-initiated cancellation, which goes through
// BookingCredit above instead. Same "no anonymous write-offs" shape as
// PlayerTab's write-off fields, except employeeId/reason are both
// required columns here (not conditionally-nullable) since every row in
// this table only ever means one thing: a required Employee attribution
// and a required reason.
model BookingRefund {
  id          String   @id @default(cuid())
  bookingId   String
  amountCents Int
  reason      String
  employeeId  String
  refundedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([bookingId])
  @@index([employeeId])
}

// Open-play cancellation policy Gate 1 (BUILD-SPEC.md's open-play
// "Cancellation policy" section) — mirrors BookingCredit exactly, same
// phone-keyed identity (a public open-play registration's real customer
// identity is `phone`, not always a registered Player, same reasoning
// as BookingCredit's own comment above). Issued automatically by
// releaseRegistration when a CONFIRMED (paid) registration is cancelled
// before the 4-hour-before-session cutoff; nothing issues it after the
// cutoff or on a no-show — those forfeit the fee with no credit, per
// policy. expiresAt defaults to 90 days from issuedAt (BUILD-SPEC's own
// proposed default for the previously-open "credit expiry" question).
// Redemption (spending a credit toward a new registration) is not built
// yet — this gate only builds issuance; noted, not built, same as the
// GCash-formula dependency note left by the expenses gate.
model OpenPlayCredit {
  id          String    @id @default(cuid())
  phone       String
  amountCents Int
  reason      String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime?
  usedAt      DateTime?

  sourceRegistrationId String
  sourceRegistration   OpenPlayNightRegistration  @relation("OpenPlayCreditSource", fields: [sourceRegistrationId], references: [id])
  usedByRegistrationId String?
  usedByRegistration   OpenPlayNightRegistration? @relation("OpenPlayCreditRedemption", fields: [usedByRegistrationId], references: [id])

  @@index([phone])
  @@index([sourceRegistrationId])
}

// A REAL cash refund for the business's OWN error (wrongly-rejected valid
// payment, genuine double payment, a staff-cancelled night) — never
// reachable from customer-initiated cancellation, which goes through
// OpenPlayCredit above instead. Same shape as BookingRefund, same "no
// anonymous refunds" reasoning as PlayerTab's write-off fields:
// employeeId/reason are both required columns, not conditionally-nullable.
model OpenPlayRefund {
  id             String   @id @default(cuid())
  registrationId String
  amountCents    Int
  reason         String
  employeeId     String
  refundedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  registration OpenPlayNightRegistration @relation(fields: [registrationId], references: [id])
  employee     Employee                  @relation(fields: [employeeId], references: [id])

  @@index([registrationId])
  @@index([employeeId])
}

// A simple retail catalog for one-time sales (SaleCategory.PRODUCT) —
// distinct from Equipment, which is rental-shaped (deposit, rental rate,
// return, RENTED status). No stock/quantity tracking: these are priced
// items sold outright (e.g. balls, T-shirts), not inventory-tracked gear.
model Product {
  id         String   @id @default(cuid())
  name       String   @unique
  priceCents Int
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  // Owner-editable count, decremented atomically on each sale
  // (productService.sellProduct) — deliberately simple given the small
  // product list: count in/count out only, no low-stock alerts, reorder
  // points, or purchase-order tracking.
  stockCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales               Sale[]
  bookingTabLineItems BookingTabLineItem[]

  @@index([sortOrder])
}

// --- Notifications & Announcements --------------------------------------

// Reshaped in Phase 9 (a pre-approved exception to the Database freeze) from
// the original Phase 2 values (BOOKING_CONFIRMATION/PAYMENT_CONFIRMATION/
// TOURNAMENT_REMINDER/MEMBERSHIP_EXPIRATION/ANNOUNCEMENT/OTHER), which had
// zero usages anywhere in app code, to one category per module that
// generates notifications.
enum NotificationType {
  BOOKING
  TOURNAMENT
  MEMBERSHIP
  EQUIPMENT
  LOCKER
  SYSTEM
  ANNOUNCEMENT
}

// entityType/entityId (Phase 9, a pre-approved exception, same shape as
// AuditLog) let generateReminders() dedupe — it only creates a Notification
// if no existing row already matches userId+type+entityType+entityId for
// the source record, so revisiting the Notification Center never spams
// duplicates — and let a notification deep-link to its source record.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  entityType String?
  entityId   String?
  title      String
  body       String
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, type, entityType, entityId])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  createdById String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([isPublished])
}

// --- Admin: Audit Logs & Settings -----------------------------------------
// AuditLog is append-only (no updatedAt/deletedAt). userId is nullable for
// system-initiated actions. Setting is a simple typed key/value store for
// app-wide configuration that shouldn't require a code change to update.

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

// v1.1 maintenance: backs every human-readable reference-number generator
// in the app (Booking/Membership/Shift/EquipmentRental/LockerRental/Sale/
// Employee/OpenPlaySession/OpenPlayMatch) — replaces the previous
// count-existing-rows approach, which silently desynced from the actual
// highest sequence number once rows were deleted, causing collisions.
// One row per scope (e.g. "BOOKING:20260722", or "EMPLOYEE" for a stable
// identifier with no date component); incremented via an atomic
// `INSERT ... ON CONFLICT DO UPDATE` (see lib/reference-counter.ts) —
// gap-tolerant by construction (a deleted downstream row never touches
// the counter) and race-free under concurrent transactions via the
// unique `scope` index, with no application-level locking needed.
model ReferenceCounter {
  scope String @id
  value Int    @default(0)
}

// --- Events ----------------------------------------------------------------
// A generic catch-all for facility activities that don't belong to Booking
// or Tournament (open play nights, clinics, corporate/private functions,
// social nights, etc.). eventType is a free-form string, not an enum or a
// table — the whole point of this model is not forcing every activity into
// a fixed shape, so the set of event types is intentionally open-ended.

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Event {
  id                   String      @id @default(cuid())
  title                String
  description          String?
  eventType            String
  startDateTime        DateTime
  endDateTime          DateTime
  capacity             Int?
  registrationRequired Boolean     @default(false)
  feeCents             Int         @default(0)
  status               EventStatus @default(DRAFT)
  createdById          String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([status])
  @@index([startDateTime, endDateTime])
}
